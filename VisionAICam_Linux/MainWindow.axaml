<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="VisionAICam_Linux.MainWindow"
        Title="VisionAICam"
        Width="1024"
        Height="768"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal">

  <Window.Resources>
    <!-- Circular Button Style -->
    <Style x:Key="CircleButtonStyle" Selector="Button">
      <Setter Property="Width" Value="60"/>
      <Setter Property="Height" Value="60"/>
      <Setter Property="Background" Value="#FFFFFFFF"/>
      <Setter Property="BorderBrush" Value="#FF2196F3"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="Foreground" Value="#FF2196F3"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid>
            <Ellipse Fill="{TemplateBinding Background}"
                     Stroke="{TemplateBinding BorderBrush}"
                     StrokeThickness="{TemplateBinding BorderThickness}"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>

    <!-- Rounded Navigation Button Style -->
    <Style x:Key="RoundedNavButtonStyle" Selector="Button">
      <Setter Property="Width" Value="110"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Margin" Value="5,15"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="20"
                  Padding="10,4">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- Bottom horizontal navigator bar -->
    <DockPanel DockPanel.Dock="Bottom" Height="70" LastChildFill="False" FlowDirection="RightToLeft">
      <DockPanel.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#FF1C1C1C" Offset="0"/>
          <GradientStop Color="#FF2E2E2E" Offset="0.5"/>
          <GradientStop Color="#FF1C1C1C" Offset="1"/>
        </LinearGradientBrush>
      </DockPanel.Background>

      <Button Content="Account"
              Background="#FFFF5722"
              BorderBrush="#FFE64A19"
              BorderThickness="2"
              Foreground="White"
              Style="{StaticResource RoundedNavButtonStyle}"
              Click="UserButton_Click"
              Margin="30,15,10,15"/>

      <Button Content="Records"
              Background="#FF03A9F4"
              BorderBrush="#FF0288D1"
              BorderThickness="2"
              Foreground="White"
              Style="{StaticResource RoundedNavButtonStyle}"
              Click="DataButton_Click"/>

      <Button Content="Debug"
              Background="#FF4CAF50"
              BorderBrush="#FF388E3C"
              BorderThickness="2"
              Foreground="White"
              Style="{StaticResource RoundedNavButtonStyle}"
              Click="DiagnosticButton_Click"/>

      <Button Content="Preferences"
              Background="#FFFFC107"
              BorderBrush="#FFFFA000"
              BorderThickness="2"
              Foreground="#FF263238"
              Style="{StaticResource RoundedNavButtonStyle}"
              Click="SettingsButton_Click"/>

      <Button Content="AI Core"
              Background="#FF00BCD4"
              BorderBrush="#FF0097A7"
              BorderThickness="2"
              Foreground="White"
              Style="{StaticResource RoundedNavButtonStyle}"
              Click="ModelButton_Click"/>

      <Button Content="Sample"
              Background="#FF009688"
              BorderBrush="#FF00796B"
              BorderThickness="2"
              Foreground="White"
              Style="{StaticResource RoundedNavButtonStyle}"
              Click="DataSetButton_Click"/>

      <Button Content="Capture"
              Background="#FF9C27B0"
              BorderBrush="#FF7B1FA2"
              BorderThickness="2"
              Foreground="White"
              Style="{StaticResource RoundedNavButtonStyle}"
              Click="CameraButton_Click"/>

      <Button Content="Run Task"
              Background="#FF3F51B5"
              BorderBrush="#FF303F9F"
              BorderThickness="2"
              Foreground="White"
              Style="{StaticResource RoundedNavButtonStyle}"
              Click="ProductionButton_Click"/>
    </DockPanel>

    <!-- Left statistics panel -->
    <Grid DockPanel.Dock="Left" Width="140" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0">
      <Image Source="avares://VisionAICam/Assets/vertical_panel.png"
             Stretch="UniformToFill" Opacity="1"/>
      <StackPanel>
        <!-- Add your statistic controls here -->
      </StackPanel>
    </Grid>

    <!-- Right-side vertical navigator bar -->
    <StackPanel DockPanel.Dock="Right"
                Orientation="Vertical"
                Width="100"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Margin="0">
      <StackPanel.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#FF212121" Offset="0"/>
          <GradientStop Color="#FF1976D2" Offset="0.5"/>
          <GradientStop Color="#FF424242" Offset="1"/>
        </LinearGradientBrush>
      </StackPanel.Background>

      <Button x:Name="StartStopButton"
              Content=""
              Margin="0,30,0,0"
              Style="{StaticResource CircleButtonStyle}"
              Click="StartStopButton_Click"
              ToolTip.Tip="Start/Stop Production"/>
      <Button x:Name="PauseButton"
              Content=""
              Margin="10"
              Style="{StaticResource CircleButtonStyle}"
              Click="PauseButton_Click"
              ToolTip.Tip="Pause/Resume Production"/>
      <Button x:Name="ExitButton"
              Content=""
              Margin="10"
              Style="{StaticResource CircleButtonStyle}"
              Click="ExitButton_Click"
              ToolTip.Tip="Exit Application"/>
    </StackPanel>

    <!-- Main content area with watermark -->
    <Grid>
      <ContentControl x:Name="MainContent"/>

      <TextBlock Text="Demo Version"
                 FontSize="60"
                 FontWeight="Bold"
                 Foreground="#661976D2"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 IsHitTestVisible="False"
                 Opacity="0.2"
                 RenderTransformOrigin="0.5,0.5">
        <TextBlock.RenderTransform>
          <RotateTransform Angle="-30"/>
        </TextBlock.RenderTransform>
      </TextBlock>
    </Grid>
  </DockPanel>
</Window>
