<Window x:Class="VisionAICam.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome" WindowStyle="None" ResizeMode="NoResize" Width="420" Height="220"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False">
    <Border Background="#FF1E1E1E" CornerRadius="8" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center">
                <TextBlock Text="VisionAI Cam" Foreground="White" FontSize="20" FontWeight="Bold" />
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,16,0,16">
                <TextBlock x:Name="StatusText" Text="Starting..." Foreground="#FFDDDDDD" FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Center" />
                <ProgressBar x:Name="ProgressBar" Margin="0,12,0,0" Height="14" Width="360" IsIndeterminate="True"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Loading..." Foreground="#FFA0A0A0" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
