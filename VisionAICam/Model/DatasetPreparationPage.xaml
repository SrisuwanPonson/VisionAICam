<Page x:Class="VisionAICam.Model.DatasetPreparationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="DatasetPreparationPage">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="340">
            <TextBlock Text="Dataset Preparation"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,24"
                       HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Button Content="Create New Dataset"
                        Height="40"
                        Width="150"
                        FontSize="16"
                        Margin="0,0,10,0"
                        Click="CreateDatasetButton_Click"/>
                <Button Content="Load Existing Dataset"
                        Height="40"
                        Width="150"
                        FontSize="16"
                        Click="LoadDatasetButton_Click"/>
            </StackPanel>
            <TextBlock Text="Use these options to create or load a YOLO-format dataset for object detection."
                       FontSize="16"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <!-- Create Dataset Panel -->
            <StackPanel x:Name="CreatePanel" Visibility="Collapsed" Margin="0,10,0,0">
                <TextBlock Text="Create New Dataset" FontWeight="Bold" FontSize="20" Margin="0,0,0,10"/>
                <TextBox x:Name="DatasetNameTextBox" Width="250" Margin="0,0,0,10"/>
                <TextBox x:Name="ClassesTextBox" Width="250" Margin="0,0,0,10" AcceptsReturn="True" Height="60"/>
                <TextBlock Text="Enter class names, one per line." FontSize="12" Foreground="Gray" Margin="0,0,0,10"/>
                <Button Content="Create" Width="120" Click="CreateButton_Click"/>
            </StackPanel>

            <!-- Load Dataset Panel -->
            <StackPanel x:Name="LoadPanel" Visibility="Collapsed" Margin="0,10,0,0">
                <TextBlock Text="Load Existing Dataset" FontWeight="Bold" FontSize="20" Margin="0,0,0,10"/>
                <Button Content="Browse..." Width="120" Click="BrowseButton_Click"/>
                <TextBlock x:Name="LoadedDatasetInfo" FontSize="14" Foreground="Gray" Margin="0,10,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
