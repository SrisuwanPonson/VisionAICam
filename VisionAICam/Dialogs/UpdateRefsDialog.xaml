<Window x:Class="VisionAICam.Dialogs.UpdateRefsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update References or Auto-tune?"
        Height="200" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Grid.Row="0"
                   Margin="4"
                   Text="Message goes here." />

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0"
                    Spacing="8">
            <Button x:Name="UpdateRefButton"
                    MinWidth="100"
                    Padding="8,4"
                    Click="UpdateRefButton_Click">Update Ref</Button>
            <Button x:Name="ContinueCalButton"
                    MinWidth="120"
                    Padding="8,4"
                    Click="ContinueCalButton_Click">Continue Cal</Button>
            <Button x:Name="CancelButton"
                    MinWidth="80"
                    Padding="8,4"
                    Click="CancelButton_Click">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>