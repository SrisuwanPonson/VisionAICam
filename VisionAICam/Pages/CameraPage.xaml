<Page x:Class="VisionAICam.Pages.CameraPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="CameraPage"
      Background="#FF2D2D30">
    <Page.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="BorderBrush" Value="#FF1565C0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#FFEDF6FF"/>
            <Setter Property="Foreground" Value="#FF1A237E"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="BorderBrush" Value="#FF90CAF9"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Page.Resources>
    <Grid Background="#FF2D2D30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Camera Controls Row -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center">
            <ComboBox x:Name="CameraComboBox"
                      Style="{StaticResource RoundedComboBoxStyle}"
                      ToolTip="Select camera device"
                      SelectionChanged="CameraComboBox_SelectionChanged"
                      MinWidth="200"/>
            <Button x:Name="SelectCameraButton"
                    Content="Select"
                    Style="{StaticResource RoundedButtonStyle}"
                    ToolTip="Start camera"
                    Click="SelectCameraButton_Click_1"/>
            <Button x:Name="StopCameraButton"
                    Content="Stop"
                    Style="{StaticResource RoundedButtonStyle}"
                    Background="#FFD32F2F"
                    BorderBrush="#FFC62828"
                    ToolTip="Stop camera"
                    Click="StopCameraButton_Click"/>
            <Button x:Name="SnapshotButton"
                    Content="Snapshot"
                    Style="{StaticResource RoundedButtonStyle}"
                    Background="#FF388E3C"
                    BorderBrush="#FF2E7D32"
                    ToolTip="Take snapshot"
                    Click="SnapshotButton_Click"/>
        </StackPanel>

        <!-- Camera Parameter Sliders Row -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,12,0,12" HorizontalAlignment="Left">
            <StackPanel Margin="0,0,24,0">
                <TextBlock Text="Brightness" FontWeight="Bold"/>
                <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="255" Width="140" ValueChanged="BrightnessSlider_ValueChanged"/>
            </StackPanel>
            <StackPanel Margin="0,0,24,0">
                <TextBlock Text="Contrast" FontWeight="Bold"/>
                <Slider x:Name="ContrastSlider" Minimum="0" Maximum="255" Width="140" ValueChanged="ContrastSlider_ValueChanged"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Exposure" FontWeight="Bold"/>
                <Slider x:Name="ExposureSlider" Minimum="-10" Maximum="-1" Width="140" ValueChanged="ExposureSlider_ValueChanged"/>
            </StackPanel>
        </StackPanel>

        <!-- Camera Image Display -->
        <Border Grid.Row="2"
                Margin="0,12,0,0"
                BorderBrush="#90CAF9"
                BorderThickness="1"
                CornerRadius="8"
                Background="#232323"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Image x:Name="CameraImage"
                   Stretch="Uniform"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   Margin="0"/>
        </Border>
    </Grid>
</Page>
