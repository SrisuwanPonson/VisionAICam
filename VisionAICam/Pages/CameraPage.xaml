<Page x:Class="VisionAICam.Pages.CameraPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="CameraPage">

    <Page.Resources>
        <!-- ✅ Dark theme palette matching Production -->
        <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#263238" Offset="0"/>
            <GradientStop Color="#37474F" Offset="0.5"/>
            <GradientStop Color="#263238" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="PanelBackground" Color="#37474F"/>
        <SolidColorBrush x:Key="CardBackground" Color="#263238"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#1976D2"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFD700"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryForeBrush" Color="#B0BEC5"/>

        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="BorderBrush" Value="#FF1565C0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#FFF0F4FF"/>
            <Setter Property="Foreground" Value="#FF1A237E"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="BorderBrush" Value="#FF90CAF9"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Page.Resources>

    <Page.Background>
        <StaticResource ResourceKey="PageBackgroundBrush"/>
    </Page.Background>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabControl" Grid.Row="0" Grid.RowSpan="4" Margin="0">
            <TabItem Header="General">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- expander with camera controls -->
                        <RowDefinition Height="*"/>
                        <!-- preview + right column -->
                    </Grid.RowDefinitions>

                    <!-- ✅ Collapsible camera/control area with dark theme -->
                    <Expander x:Name="ControlExpander"
                              Grid.Row="0"
                              IsExpanded="True"
                              Expanded="ControlExpander_Expanded"
                              Collapsed="ControlExpander_Collapsed"
                              BorderThickness="1"
                              BorderBrush="{StaticResource PanelBorderBrush}"
                              Background="{StaticResource PanelBackground}"
                              Margin="0,0,0,8"
                              Padding="8">
                        <Expander.Header>
                            <DockPanel LastChildFill="False">
                                <Button x:Name="CollapseButton"
                                        Content="▾"
                                        Width="28"
                                        Height="24"
                                        Margin="0,0,8,0"
                                        Click="CollapseButton_Click"
                                        DockPanel.Dock="Left"/>
                                <TextBlock Text="⚙️ Camera Controls" 
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="Bold"
                                           FontSize="14"/>
                            </DockPanel>
                        </Expander.Header>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                                <ComboBox x:Name="BackendComboBox"
                                          Style="{StaticResource RoundedComboBoxStyle}"
                                          Width="150"
                                          Margin="0,0,12,0"
                                          ToolTip="Select backend (OpenCV / Hikvision)"/>
                                <ComboBox x:Name="CameraComboBox"
                                          Style="{StaticResource RoundedComboBoxStyle}"
                                          ToolTip="Select camera device"
                                          SelectionChanged="CameraComboBox_SelectionChanged"/>
                                <!-- ✅ Select button with icon -->
                                <Button x:Name="SelectCameraButton"
                                       Style="{StaticResource RoundedButtonStyle}"
                                       ToolTip="Start camera"
                                       Width="120"
                                       Click="SelectCameraButton_Click_1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▶️ " FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="Select" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <!-- ✅ Stop button with icon -->
                                <Button x:Name="StopCameraButton"
                                       Style="{StaticResource RoundedButtonStyle}"
                                       Background="#FFD32F2F"
                                       BorderBrush="#FFC62828"
                                       ToolTip="Stop camera"
                                       Width="120"
                                       Click="StopCameraButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⏹️ " FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="Stop" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- CAMERA SLIDERS -->
                            <Grid Margin="0,0,0,12">

                                <!-- OpenCV Sliders -->
                                <StackPanel x:Name="OpenCVSliderPanel"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            Visibility="Visible">

                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}">
                                            <Run Text="☀️ "/>
                                            <Run Text="Brightness"/>
                                        </TextBlock>
                                        <Slider x:Name="BrightnessSlider"
                                                Minimum="0" Maximum="255" Width="140"
                                                ValueChanged="BrightnessSlider_ValueChanged"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}">
                                            <Run Text="🎚️ "/>
                                            <Run Text="Contrast"/>
                                        </TextBlock>
                                        <Slider x:Name="ContrastSlider"
                                                Minimum="0" Maximum="255" Width="140"
                                                ValueChanged="ContrastSlider_ValueChanged"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}">
                                            <Run Text="📷 "/>
                                            <Run Text="Exposure"/>
                                        </TextBlock>
                                        <Slider x:Name="ExposureSlider"
                                                Minimum="-10" Maximum="10" Width="140"
                                                ValueChanged="ExposureSlider_ValueChanged"/>
                                    </StackPanel>

                                </StackPanel>

                                <!-- Hikvision Sliders -->
                                <StackPanel x:Name="HikSliderPanel"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            Visibility="Collapsed">

                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}">
                                            <Run Text="📷 "/>
                                            <Run Text="Exposure (µs)"/>
                                        </TextBlock>
                                        <Slider x:Name="HikExposureSlider"
                                                Minimum="100" Maximum="60000" Width="140"
                                                ValueChanged="HikExposureSlider_ValueChanged"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}">
                                            <Run Text="📶 "/>
                                            <Run Text="Gain"/>
                                        </TextBlock>
                                        <Slider x:Name="HikGainSlider"
                                                Minimum="0" Maximum="20" Width="140"
                                                ValueChanged="HikGainSlider_ValueChanged"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}">
                                            <Run Text="🌓 "/>
                                            <Run Text="Gamma"/>
                                        </TextBlock>
                                        <Slider x:Name="HikGammaSlider"
                                                Minimum="0.1" Maximum="3.0" Width="140"
                                                ValueChanged="HikGammaSlider_ValueChanged"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}">
                                            <Run Text="⚫ "/>
                                            <Run Text="Black Level"/>
                                        </TextBlock>
                                        <Slider x:Name="HikBlackSlider"
                                                Minimum="0" Maximum="20" Width="140"
                                                ValueChanged="HikBlackSlider_ValueChanged"/>
                                    </StackPanel>

                                </StackPanel>

                            </Grid>

                            <!-- ✅ Save Settings Button with icon -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0" HorizontalAlignment="Left">
                                <Button x:Name="SaveCameraButton"
                                        Style="{StaticResource RoundedButtonStyle}"
                                        Width="160"
                                        IsEnabled="False"
                                        Click="SaveCameraSettingsButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💾 " FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="Save Settings" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="SaveStatusSmall" Text="" Foreground="#4CAF50" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- Main preview + right Image Preparation -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Live preview -->
                        <Border Grid.Column="0"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="2"
                                CornerRadius="8"
                                Background="#000000"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Margin="0,0,12,0">
                            <Viewbox Stretch="Uniform">
                                <Grid Width="640" Height="480">
                                    <Image x:Name="CameraImage" 
                                           Width="640" Height="480"
                                           Stretch="Uniform" 
                                           HorizontalAlignment="Stretch" 
                                           VerticalAlignment="Stretch"/>
                                    <Canvas x:Name="OverlayCanvas" 
                                            Width="640" Height="480"
                                            IsHitTestVisible="False" 
                                            Background="Transparent"/>
                                </Grid>
                            </Viewbox>
                        </Border>

                        <!-- Right: Image Preparation -->
                        <Border Grid.Column="1"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="2"
                                CornerRadius="6"
                                Background="{StaticResource PanelBackground}"
                                Padding="8">
                            <StackPanel VerticalAlignment="Top" Margin="4">
                                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                    <TextBlock Text="🖼️ Image Preparation" 
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Foreground="{StaticResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               DockPanel.Dock="Left"/>
                                    <Button x:Name="ImgPrepToggleButton" 
                                            Content="▾" 
                                            Width="28" 
                                            Height="24" 
                                            DockPanel.Dock="Right" 
                                            Margin="0,0,0,0" 
                                            Click="ImgPrepToggleButton_Click"/>
                                </DockPanel>

                                <GroupBox x:Name="ImagePrepGroupBox"
                                          Header=""
                                          Margin="0"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          HorizontalAlignment="Stretch">

                                    <Grid Margin="0"
                                          Height="Auto"
                                          HorizontalAlignment="Stretch">

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- ✅ Object Class with icon -->
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Grid.ColumnSpan="2"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource ForegroundBrush}"
                                                   FontWeight="SemiBold">
                                            <Run Text="🏷️ "/>
                                            <Run Text="Object Class:"/>
                                        </TextBlock>

                                        <ComboBox x:Name="ClassComboBox"
                                                  Grid.Row="1" Grid.Column="0"
                                                  Grid.ColumnSpan="2"
                                                  Margin="0,4,0,4"
                                                  HorizontalAlignment="Stretch"
                                                  Style="{StaticResource RoundedComboBoxStyle}"/>

                                        <!-- ✅ Category with icon -->
                                        <TextBlock Grid.Row="2" Grid.Column="0"
                                                   Grid.ColumnSpan="2"
                                                   VerticalAlignment="Center" 
                                                   Margin="0,8,0,0"
                                                   Foreground="{StaticResource ForegroundBrush}"
                                                   FontWeight="SemiBold">
                                            <Run Text="📂 "/>
                                            <Run Text="Category:"/>
                                        </TextBlock>

                                        <ComboBox x:Name="CategoryComboBox"
                                                  Grid.Row="3" Grid.Column="0"
                                                  Grid.ColumnSpan="2"
                                                  Margin="0,4,0,4"
                                                  HorizontalAlignment="Stretch"
                                                  Style="{StaticResource RoundedComboBoxStyle}"/>

                                        <!-- ✅ Snapshot button with icon -->
                                        <Button x:Name="SnapshotButton"
                                                Grid.Row="4" Grid.Column="0"
                                                Style="{StaticResource RoundedButtonStyle}"
                                                Background="#FF388E3C"
                                                BorderBrush="#FF2E7D32"
                                                Grid.ColumnSpan="2"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,5,0,5"
                                                Click="SnapshotButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📸 " FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Text="Snapshot" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <TextBlock x:Name="lblSaveStatus"
                                                   Grid.Row="5" Grid.Column="0"
                                                   Grid.ColumnSpan="2"
                                                   Text=""
                                                   Foreground="#4CAF50"
                                                   FontWeight="SemiBold"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </GroupBox>

                                <!-- ✅ Calibration status with icon -->
                                <Border Background="{StaticResource CardBackground}"
                                        BorderBrush="{StaticResource PanelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8"
                                        Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📊 Status: " 
                                                   Foreground="{StaticResource SecondaryForeBrush}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <Label x:Name="CalibStatus" 
                                               Content="Ready" 
                                               Foreground="{StaticResource AccentBrush}"
                                               FontWeight="Bold"
                                               Padding="0"
                                               VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ✅ Calibrate tab with icons -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎨 " FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Calibrate" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ✅ Header buttons with icons -->
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8" HorizontalAlignment="Left">
                        <Button x:Name="AutoCalibrateButton" 
                                Style="{StaticResource RoundedButtonStyle}" 
                                Width="180" 
                                Click="AutoCalibrateButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔧 " FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Start Calibration" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ApplyCalibButton" 
                                Style="{StaticResource RoundedButtonStyle}" 
                                Width="120">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✅ " FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Apply" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ResetCalibButton" 
                                Style="{StaticResource RoundedButtonStyle}" 
                                Width="120" 
                                Background="#FFE0E0E0" 
                                Foreground="#FF000000">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄 " FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Reset" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Left: Cloned preview -->
                    <Border Grid.Row="1" Grid.Column="0"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="2"
                            CornerRadius="8"
                            Background="#000000"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Margin="0,0,12,0">
                        <Viewbox Stretch="Uniform">
                            <Grid Width="640" Height="480">
                                <Image x:Name="CalibImage" 
                                       Width="640" Height="480"
                                       Stretch="Uniform" 
                                       HorizontalAlignment="Stretch" 
                                       VerticalAlignment="Stretch"/>
                                <Canvas x:Name="CalibOverlayCanvas" 
                                        Width="640" Height="480"
                                        IsHitTestVisible="False" 
                                        Background="Transparent"/>
                            </Grid>
                        </Viewbox>
                    </Border>

                    <!-- Right: Reference colors -->
                    <Border Grid.Row="1" Grid.Column="1"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="2"
                            CornerRadius="6"
                            Background="{StaticResource PanelBackground}"
                            Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel VerticalAlignment="Top" Margin="4">
                                <TextBlock Text="🎨 Calibration References" 
                                           FontWeight="Bold" 
                                           FontSize="14"
                                           Foreground="{StaticResource AccentBrush}"
                                           Margin="0,0,0,12"/>

                                <!-- ✅ Color references with icons -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,4" VerticalAlignment="Center">
                                    <TextBlock Text="🔴 " FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Border x:Name="RectRed" Width="22" Height="22" CornerRadius="3" BorderBrush="Gray" BorderThickness="1" Margin="0,0,8,0" Background="#FF795337"/>
                                    <TextBox x:Name="TxtRefRed" Width="100" IsReadOnly="True" Margin="0,0,8,0"/>
                                    <Button x:Name="BtnEditRed" Content="✏️ Edit" Width="70" Click="EditSaveRef_Click"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,4" VerticalAlignment="Center">
                                    <TextBlock Text="🟢 " FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Border x:Name="RectGreen" Width="22" Height="22" CornerRadius="3" BorderBrush="Gray" BorderThickness="1" Margin="0,0,8,0" Background="#FF4D5D55"/>
                                    <TextBox x:Name="TxtRefGreen" Width="100" IsReadOnly="True" Margin="0,0,8,0"/>
                                    <Button x:Name="BtnEditGreen" Content="✏️ Edit" Width="70" Click="EditSaveRef_Click"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,4" VerticalAlignment="Center">
                                    <TextBlock Text="🔵 " FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Border x:Name="RectBlue" Width="22" Height="22" CornerRadius="3" BorderBrush="Gray" BorderThickness="1" Margin="0,0,8,0" Background="#FF2B4267"/>
                                    <TextBox x:Name="TxtRefBlue" Width="100" IsReadOnly="True" Margin="0,0,8,0"/>
                                    <Button x:Name="BtnEditBlue" Content="✏️ Edit" Width="70" Click="EditSaveRef_Click"/>
                                </StackPanel>

                                <Border Background="{StaticResource CardBackground}"
                                        BorderBrush="{StaticResource PanelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8"
                                        Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📊 Status: " 
                                                   Foreground="{StaticResource SecondaryForeBrush}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <Label x:Name="CalibTabStatus" 
                                               Content="Ready" 
                                               Foreground="{StaticResource AccentBrush}"
                                               FontWeight="Bold"
                                               Padding="0"
                                               VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Decision panel -->
                                <Border x:Name="CalibDecisionPanel"
                                        Visibility="Collapsed"
                                        Background="{StaticResource CardBackground}"
                                        BorderBrush="{StaticResource PanelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8"
                                        Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Measured values captured. Update stored references or run auto-tune?" 
                                                   TextWrapping="Wrap" 
                                                   Foreground="{StaticResource ForegroundBrush}"
                                                   Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="CalibDecisionSaveButton" Content="💾 Save" Width="90" Click="CalibDecision_SaveRefs_Click" Margin="0,0,8,0"/>
                                            <Button x:Name="CalibDecisionAutoTuneButton" Content="🎛️ Tune" Width="80" Click="CalibDecision_AutoTune_Click" Margin="0,0,8,0"/>
                                            <Button x:Name="CalibDecisionCancelButton" Content="❌ Cancel" Width="90" Click="CalibDecision_Cancel_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Complete panel -->
                                <Border x:Name="CalibCompletePanel"
                                        Visibility="Collapsed"
                                        Background="#FFFDF3E0"
                                        BorderBrush="#FFCC8A1A"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8"
                                        Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="✅ Station calibration complete." FontWeight="Bold" Margin="0,0,0,6"/>
                                        <TextBlock Text="Save current Brightness / Contrast / Exposure to application settings?" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="CalibSaveButton" 
                                                    Style="{StaticResource RoundedButtonStyle}" 
                                                    Width="140" 
                                                    Click="CalibSaveButton_Click" 
                                                    Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="💾 " FontSize="14" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Save Settings" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="CalibDontSaveButton" 
                                                    Style="{StaticResource RoundedButtonStyle}" 
                                                    Width="120" 
                                                    Click="CalibDontSaveButton_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="❌ " FontSize="14" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Don't Save" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Sample prepare panel -->
                                <Border x:Name="SamplePreparePanel"
                                        Visibility="Collapsed"
                                        Background="{StaticResource CardBackground}"
                                        BorderBrush="{StaticResource PanelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="SamplePrepareTitle" 
                                                   Text="Adjust preview boxes" 
                                                   FontWeight="Bold" 
                                                   FontSize="16" 
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Margin="0,0,0,8"/>
                                        <TextBlock x:Name="SamplePrepareText" 
                                                   TextWrapping="Wrap" 
                                                   Foreground="{StaticResource ForegroundBrush}"
                                                   Margin="0,0,0,12">
                                            Please adjust the three boxes so each is centered inside its target color area.
                                            Click OK when ready, or Cancel to abort.
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="SamplePrepareOk" Content="OK" Width="88" Margin="0,0,8,0" IsDefault="True" Click="SamplePrepareOk_Click"/>
                                            <Button x:Name="SamplePrepareCancel" Content="Cancel" Width="88" IsCancel="True" Click="SamplePrepareCancel_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>