<Page x:Class="VisionAICam.Pages.CameraPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VisionAICam.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CameraPage">

    <Page.Resources>
        <!-- Rounded Button Style -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,8,8,8"/>
            <Setter Property="BorderBrush" Value="#FF1565C0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Simple ComboBox Style (no custom template, so no errors) -->
        <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#FFEDF6FF"/>
            <Setter Property="Foreground" Value="#FF1A237E"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="Margin" Value="0,8,8,8"/>
            <Setter Property="BorderBrush" Value="#FF90CAF9"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Border BorderBrush="Gray" BorderThickness="1" Background="LightBlue"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Controls Row -->
                <ComboBox x:Name="CameraComboBox"
                          Grid.Row="0" Grid.Column="0"
                          Style="{StaticResource RoundedComboBoxStyle}"/>
                <Button x:Name="SelectCameraButton"
                        Content="Select Camera"
                        Grid.Row="0" Grid.Column="1"
                        Style="{StaticResource RoundedButtonStyle}"
                        Click="SelectCameraButton_Click_1"/>
                <Button x:Name="StopCameraButton"
                        Content="Stop Camera"
                        Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource RoundedButtonStyle}"
                        Background="#FFD32F2F"
                        BorderBrush="#FFC62828"
                        Click="StopCameraButton_Click"/>
                <Button x:Name="SnapshotButton"
                        Content="Snapshot"
                        Grid.Row="0" Grid.Column="3"
                        Style="{StaticResource RoundedButtonStyle}"
                        Background="#FF388E3C"
                        BorderBrush="#FF2E7D32"
                        Margin="0,8,0,8"
                        Click="SnapshotButton_Click"/>

                <!-- Image Row -->
                <Image x:Name="CameraImage"
                       Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                       Stretch="Uniform"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Margin="0,8,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Page>
