<Page x:Class="VisionAICam.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="UserPage">

    <Page.Resources>
        <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5F5F5" Offset="0"/>
            <GradientStop Color="#E0E0E0" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <Style TargetType="Border">
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFAFA"/>
        </Style>
    </Page.Resources>

    <Page.Background>
        <StaticResource ResourceKey="PageBackgroundBrush"/>
    </Page.Background>

    <Grid Margin="24">
        <TabControl x:Name="UserTabControl">

            <!-- Profile Tab -->
            <TabItem Header="Profile">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="User Profile" FontSize="30" FontWeight="Bold" Grid.ColumnSpan="2" Margin="0,0,0,20"/>

                    <!-- Profile Image -->
                    <StackPanel Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center">
                        <Border Width="120" Height="120" CornerRadius="60" Margin="0,0,0,10">
                            <Image x:Name="ProfileImage" Stretch="UniformToFill"/>
                        </Border>
                        <Button Content="Change Photo" Width="120" Click="ChangePhotoButton_Click"/>
                    </StackPanel>

                    <!-- User Info -->
                    <Grid Grid.Row="1" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="UserNameText" Text="John Doe" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Email:" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="UserEmailText" Text="johndoe@example.com" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Role:" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="UserRoleText" Text="Admin" Margin="0,0,0,20"/>

                        <Button Grid.Row="3" Grid.ColumnSpan="2" Content="Edit Profile" Width="120" HorizontalAlignment="Left" Click="EditProfileButton_Click"/>
                        <Button Grid.Row="4" Grid.ColumnSpan="2" Content="Change Password" Width="120" HorizontalAlignment="Left" Click="ChangePasswordButton_Click"/>
                        <Button Grid.Row="5" Grid.ColumnSpan="2" Content="Logout" Width="120" HorizontalAlignment="Left" Click="LogoutButton_Click"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Login Tab -->
            <TabItem Header="Login">
                <Grid Margin="40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Username:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="LoginUsernameTextBox" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Password:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="LoginPasswordBox" Margin="0,0,0,20"/>

                    <Button Grid.Row="2" Grid.Column="1" Content="Login" Width="100" HorizontalAlignment="Left" Click="LoginButton_Click"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LoginErrorText" Foreground="Red" Margin="0,10,0,0"/>
                </Grid>
            </TabItem>

            <!-- Register Tab -->
            <TabItem Header="Register">
                <Grid Margin="40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Username:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="RegUsernameTextBox" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Email:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="RegEmailTextBox" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Password:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="RegPasswordBox" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Confirm:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="RegConfirmPasswordBox" Margin="0,0,0,20"/>

                    <Button Grid.Row="4" Grid.Column="1" Content="Register" Width="100" HorizontalAlignment="Left" Click="RegisterButton_Click"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="RegisterErrorText" Foreground="Red" Margin="0,10,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>