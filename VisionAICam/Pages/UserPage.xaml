<Page x:Class="VisionAICam.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="UserPage">

    <Page.Resources>
        <!-- ✅ Dark theme palette matching other pages -->
        <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#263238" Offset="0"/>
            <GradientStop Color="#37474F" Offset="0.5"/>
            <GradientStop Color="#263238" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="PanelBackground" Color="#37474F"/>
        <SolidColorBrush x:Key="CardBackground" Color="#263238"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#1976D2"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFD700"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryForeBrush" Color="#B0BEC5"/>

        <!-- ✅ TextBlock style -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- ✅ Button style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2196F3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ✅ Border style -->
        <Style TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        </Style>

        <!-- ✅ TextBox style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- ✅ PasswordBox style -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- ✅ TabControl style -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- ✅ TabItem style -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,6"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource CardBackground}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Page.Background>
        <StaticResource ResourceKey="PageBackgroundBrush"/>
    </Page.Background>

    <Grid Margin="24">
        <TabControl x:Name="UserTabControl">

            <!-- Profile Tab -->
            <TabItem Header="👤 Profile">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="User Profile" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Grid.ColumnSpan="2" Margin="0,0,0,20"/>

                    <!-- Profile Image -->
                    <StackPanel Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center">
                        <Border Width="120" Height="120" CornerRadius="60" Margin="0,0,0,10">
                            <Image x:Name="ProfileImage" Stretch="UniformToFill"/>
                        </Border>
                        <Button Content="Change Photo" Width="120" Click="ChangePhotoButton_Click"/>
                    </StackPanel>

                    <!-- User Info -->
                    <Grid Grid.Row="1" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="UserNameText" Text="John Doe" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Email:" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="UserEmailText" Text="johndoe@example.com" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Role:" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="UserRoleText" Text="Admin" Margin="0,0,0,20"/>

                        <Button Grid.Row="3" Grid.ColumnSpan="2" Content="Edit Profile" Width="120" HorizontalAlignment="Left" Click="EditProfileButton_Click"/>
                        <Button Grid.Row="4" Grid.ColumnSpan="2" Content="Change Password" Width="120" HorizontalAlignment="Left" Click="ChangePasswordButton_Click"/>
                        <Button Grid.Row="5" Grid.ColumnSpan="2" Content="Logout" Width="120" HorizontalAlignment="Left" Click="LogoutButton_Click"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Login Tab -->
            <TabItem Header="🔐 Login">
                <Grid Margin="40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Username:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="LoginUsernameTextBox" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Password:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="LoginPasswordBox" Margin="0,0,0,20"/>

                    <Button Grid.Row="2" Grid.Column="1" Content="Login" Width="100" HorizontalAlignment="Left" Click="LoginButton_Click"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LoginErrorText" Foreground="#F44336" Margin="0,10,0,0"/>
                </Grid>
            </TabItem>

            <!-- Register Tab -->
            <TabItem Header="📝 Register">
                <Grid Margin="40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Username:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="RegUsernameTextBox" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Email:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="RegEmailTextBox" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Password:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="RegPasswordBox" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Confirm:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                    <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="RegConfirmPasswordBox" Margin="0,0,0,20"/>

                    <Button Grid.Row="4" Grid.Column="1" Content="Register" Width="100" HorizontalAlignment="Left" Click="RegisterButton_Click"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="RegisterErrorText" Foreground="#F44336" Margin="0,10,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>