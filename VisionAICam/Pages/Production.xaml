<Page x:Class="VisionAICam.Pages.Production"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Production"
      Width="800"
      Height="450">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Image with bounding boxes -->
        <Border Grid.Column="0" Grid.Row="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0">
            <Grid>
                <Image x:Name="ProductionImage" Stretch="Uniform"/>
                <!-- Overlay Canvas for bounding boxes -->
                <Canvas x:Name="BoundingBoxCanvas" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- Detection results and controls -->
        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Vertical">
            <TextBlock Text="Detections" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <ListView x:Name="DetectionListView" Height="250" Margin="0,0,0,10">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Class" Width="80" DisplayMemberBinding="{Binding ClassName}"/>
                        <GridViewColumn Header="Confidence" Width="80" DisplayMemberBinding="{Binding Confidence}"/>
                        <GridViewColumn Header="Box" Width="120" DisplayMemberBinding="{Binding Box}"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <Button Content="Snapshot" Width="80" Click="SnapshotButton_Click"/>
        </StackPanel>

        <!-- Status bar -->
        <StatusBar Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Ready"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="FpsTextBlock" Text="FPS: 0"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="InferenceTimeTextBlock" Text="Inference: 0 ms"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Page>
