<Page x:Class="VisionAICam.Pages.Production"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Production">

    <Page.Resources>
        <DropShadowEffect x:Key="PanelShadow"
                          Color="Black"
                          Direction="270"
                          ShadowDepth="4"
                          Opacity="0.1"
                          BlurRadius="6"/>
        <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5F5F5" Offset="0"/>
            <GradientStop Color="#E0E0E0" Offset="1"/>
        </LinearGradientBrush>
    </Page.Resources>

    <Page.Background>
        <StaticResource ResourceKey="PageBackgroundBrush"/>
    </Page.Background>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <GroupBox Header="Camera Feed"
                      FontSize="18"
                      FontWeight="Bold"
                      Padding="12"
                      Background="#FAFAFA"
                      BorderBrush="#D0D7DE"
                      BorderThickness="1"
                      Effect="{StaticResource PanelShadow}"
                      VerticalAlignment="Top">
                <StackPanel>
                    <!-- Fixed-size image and canvas -->
                    <Border Width="640" Height="480"
                            Background="#FFFFFF"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="4">
                        <!-- Use a Grid to layer elements -->
                        <Grid>
                            <!-- Camera image and canvas -->
                            <Image x:Name="ProductionImage"
                                   Width="640" Height="480"
                                   Stretch="None"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"/>
                            <Canvas x:Name="BoundingBoxCanvas"
                                    Width="640" Height="480"
                                    IsHitTestVisible="False"/>
                            <!-- Loading overlay -->
                            <Grid x:Name="LoadingOverlay"
                                  Background="#80D0D7DE"
                                  Visibility="Collapsed"
                                  Width="640" Height="480">
                                <Border Background="#CCD0D7DE"
                                        Padding="24"
                                        CornerRadius="8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="Loading model and running first inference..."
                                                   Foreground="#222"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,12"
                                                   TextAlignment="Center"/>
                                        <ProgressBar IsIndeterminate="True"
                                                     Width="180"
                                                     Height="14"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <!-- Model Selection Overlay: ensure this is last for topmost rendering -->
                            <Border Width="496"
                                    Padding="12"
                                    Background="#F5F5F5"
                                    BorderBrush="#D0D7DE"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Effect="{StaticResource PanelShadow}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Margin="0,12,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <RadioButton x:Name="AabbRadio"
                                                     Content="Object Detection (AABB)"
                                                     FontSize="13"
                                                     Margin="0,4,12,4"
                                                     GroupName="ModelType"
                                                     ToolTip="Axis-aligned bounding box detection. / ตรวจจับวัตถุแบบกรอบสี่เหลี่ยม" Checked="AabbRadio_Checked"/>
                                        <RadioButton x:Name="ObbRadio"
                                                     Content="Object Detection (OBB)"
                                                     FontSize="13"
                                                     Margin="0,4,12,4"
                                                     GroupName="ModelType"
                                                     ToolTip="Oriented bounding box detection. / ตรวจจับวัตถุแบบกรอบหมุนได้" Checked="ObbRadio_Checked"/>
                                        <RadioButton x:Name="SegmentationRadio"
                                                     Content="Segmentation"
                                                     FontSize="13"
                                                     Margin="0,4,0,4"
                                                     GroupName="ModelType"
                                                     ToolTip="Pixel-level segmentation. / การแบ่งส่วนภาพระดับพิกเซล" Checked="SegmentationRadio_Checked"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Status Bar -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock x:Name="StatusTextBlock"
                                   Text="Ready"
                                   FontSize="13"
                                   Foreground="#444"
                                   Margin="0,0,24,0"/>
                        <TextBlock x:Name="FpsTextBlock"
                                   Text="FPS: 0"
                                   FontSize="13"
                                   Foreground="#444"
                                   Margin="0,0,24,0"/>
                        <TextBlock x:Name="InferenceTimeTextBlock"
                                   Text="Inference: 0 ms"
                                   FontSize="13"
                                   Foreground="#444"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </Grid>
    </ScrollViewer>
</Page>