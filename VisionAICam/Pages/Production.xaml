<Page x:Class="VisionAICam.Pages.Production"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Production">

    <Page.Resources>
        <DropShadowEffect x:Key="PanelShadow"
                          Color="Black"
                          Direction="270"
                          ShadowDepth="4"
                          Opacity="0.1"
                          BlurRadius="6"/>

        <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5F5F5" Offset="0"/>
            <GradientStop Color="#E0E0E0" Offset="1"/>
        </LinearGradientBrush>
    </Page.Resources>

    <Page.Background>
        <StaticResource ResourceKey="PageBackgroundBrush"/>
    </Page.Background>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <GroupBox Header="Camera Feed"
                      FontSize="18"
                      FontWeight="Bold"
                      Padding="12"
                      Background="#FAFAFA"
                      BorderBrush="#D0D7DE"
                      BorderThickness="1"
                      Effect="{StaticResource PanelShadow}"
                      VerticalAlignment="Top">
                <StackPanel>
                    <!-- Fixed-size image and canvas -->
                    <Border Width="640" Height="480"
                            Background="#FFFFFF"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="4">
                        <Grid>
                            <Image x:Name="ProductionImage"
                                   Width="640" Height="480"
                                   Stretch="None"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"/>
                            <Canvas x:Name="BoundingBoxCanvas"
                                    Width="640" Height="480"
                                    IsHitTestVisible="False"/>
                            <Grid x:Name="LoadingOverlay"
                                  Background="#80D0D7DE"
                                  Visibility="Collapsed"
                                  Width="640" Height="480">
                                <Border Background="#CCD0D7DE"
                                        Padding="24"
                                        CornerRadius="8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="Loading model and running first inference..."
                                                   Foreground="#222"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,12"
                                                   TextAlignment="Center"/>
                                        <ProgressBar IsIndeterminate="True"
                                                     Width="180"
                                                     Height="14"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Status Bar -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock x:Name="StatusTextBlock"
                                   Text="Ready"
                                   FontSize="13"
                                   Foreground="#444"
                                   Margin="0,0,24,0"/>
                        <TextBlock x:Name="FpsTextBlock"
                                   Text="FPS: 0"
                                   FontSize="13"
                                   Foreground="#444"
                                   Margin="0,0,24,0"/>
                        <TextBlock x:Name="InferenceTimeTextBlock"
                                   Text="Inference: 0 ms"
                                   FontSize="13"
                                   Foreground="#444"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </Grid>
    </ScrollViewer>
</Page>