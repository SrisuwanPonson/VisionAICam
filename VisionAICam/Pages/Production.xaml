<Page x:Class="VisionAICam.Pages.Production"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Production"
      Width="1232"
      Height="693"
      x:Name="ProductionPage">

    <Grid Margin="31">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Image with bounding boxes -->
        <Border Grid.Column="0" Grid.Row="0" BorderBrush="Gray" BorderThickness="1.54" CornerRadius="12.32" Margin="0,0,15.4,0"
                MinWidth="616" MinHeight="462">
            <Grid>
                <Image x:Name="ProductionImage"
                       Stretch="Uniform"
                       MinWidth="616"
                       MinHeight="462"
                       HorizontalAlignment="Stretch"
                       AutomationProperties.Name="Production Image"/>
                <!-- Overlay Canvas for bounding boxes -->
                <Canvas x:Name="BoundingBoxCanvas" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- Detection results and controls -->
        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Vertical">
            <TextBlock Text="Detections" FontSize="27.5" FontWeight="Bold" Margin="0,0,0,15.4"/>
            <ListView x:Name="DetectionListView"
                      Height="385"
                      Margin="0,0,0,15.4"
                      SelectionMode="Single"
                      AutomationProperties.Name="Detection Results">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Class" Width="123.2" DisplayMemberBinding="{Binding ClassName}"/>
                        <GridViewColumn Header="Confidence" Width="123.2" DisplayMemberBinding="{Binding Confidence}"/>
                        <GridViewColumn Header="Box" Width="184.8" DisplayMemberBinding="{Binding Box}"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <Button x:Name="SnapshotButton"
                    Content="Snapshot"
                    Width="123.2"
                    Height="36.3"
                    FontSize="12.1"
                    VerticalAlignment="Center"
                    Click="SnapshotButton_Click"
                    ToolTip="Take a snapshot of the current frame"
                    AutomationProperties.Name="Snapshot Button"/>
        </StackPanel>

        <!-- Status bar -->
        <StatusBar Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Margin="0,15.4,0,0" Height="36.3">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Ready" FontSize="12.1"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="FpsTextBlock" Text="FPS: 0" FontSize="12.1"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="InferenceTimeTextBlock" Text="Inference: 0 ms" FontSize="12.1"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Page>
