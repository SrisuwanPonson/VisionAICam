<Page x:Class="VisionAICam.Pages.ModelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:VisionAICam.Pages"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="ModelPage">

    <Page.Resources>
        <!-- ✅ Dark theme palette matching DataSetPage -->
        <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#263238" Offset="0"/>
            <GradientStop Color="#37474F" Offset="0.5"/>
            <GradientStop Color="#263238" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="PanelBackground" Color="#37474F"/>
        <SolidColorBrush x:Key="CardBackground" Color="#263238"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#1976D2"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFD700"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryForeBrush" Color="#B0BEC5"/>

        <!-- ✅ Shadow effect for panels -->
        <DropShadowEffect x:Key="ShadowEffect"
                          Color="#1976D2"
                          Direction="270"
                          ShadowDepth="0"
                          Opacity="0.6"
                          BlurRadius="12"/>
    </Page.Resources>

    <Page.Background>
        <StaticResource ResourceKey="PageBackgroundBrush"/>
    </Page.Background>

    <DockPanel LastChildFill="True">
        <!-- ✅ Menu Bar with dark theme -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource PanelBackground}" Foreground="{StaticResource ForegroundBrush}">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
                    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
                    <Setter Property="Margin" Value="2"/>
                </Style>
            </Menu.Resources>

            <MenuItem Header="📁 File">
                <MenuItem Header="New Project" Click="NewModel_Click"/>
                <MenuItem Header="Open Project" Click="OpenModel_Click"/>
                <Separator/>
                <MenuItem Header="Save Project" Click="SaveModel_Click"/>
                <MenuItem Header="Export Project" Click="ExportModel_Click"/>
                <MenuItem Header="Close Project" Click="CloseModel_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="✏️ Edit">
                <MenuItem Header="Undo" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
                <MenuItem Header="Redo" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
            </MenuItem>
            <MenuItem Header="👁️ View">
                <MenuItem Header="Full Screen" InputGestureText="F11" Click="FullScreenToggleButton_Click"/>
            </MenuItem>
            <MenuItem Header="❓ Help">
                <MenuItem Header="View Help" Click="ViewHelp_Click"/>
                <MenuItem Header="About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- ✅ Main Workspace with dark theme -->
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ✅ Model Training Configuration Panel -->
            <Grid x:Name="ConfigPanelGrid" Grid.Row="0" Visibility="Collapsed">
                <Border
                    Background="{StaticResource PanelBackground}"
                    CornerRadius="8"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="2"
                    Padding="20,14"
                    Margin="0,0,0,16"
                    Effect="{StaticResource ShadowEffect}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Project Type -->
                        <TextBlock Text="🎯 Project:" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,8,0"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="14"/>
                        <ComboBox x:Name="ProjectTypeComboBox" 
                                  Width="200" 
                                  Height="32"
                                  Margin="0,0,20,0" 
                                  SelectionChanged="ProjectTypeComboBox_SelectionChanged"
                                  Background="{StaticResource CardBackground}"
                                  Foreground="{StaticResource ForegroundBrush}"
                                  BorderBrush="{StaticResource PanelBorderBrush}"
                                  FontSize="14">
                            <ComboBoxItem Content="Object Detection" IsSelected="True"/>
                            <ComboBoxItem Content="Image Classification"/>
                            <ComboBoxItem Content="Defect Detection"/>
                        </ComboBox>

                        <!-- Dataset -->
                        <TextBlock Text="📊 Dataset:" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,8,0"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="14"/>
                        <ComboBox x:Name="DatasetComboBox" 
                                  Width="180" 
                                  Height="32"
                                  Margin="0,0,10,0"
                                  Background="{StaticResource CardBackground}"
                                  Foreground="{StaticResource ForegroundBrush}"
                                  BorderBrush="{StaticResource PanelBorderBrush}"
                                  FontSize="14"/>
                        <Button Content="Browse..." 
                                Width="90" 
                                Height="32"
                                Click="BrowseDataset_Click" 
                                Margin="0,0,20,0"
                                Background="{StaticResource PanelBorderBrush}"
                                Foreground="White"
                                BorderBrush="{StaticResource AccentBrush}"
                                FontWeight="SemiBold"
                                Cursor="Hand"/>

                        <!-- Model Architecture -->
                        <TextBlock Text="🤖 Model:" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,8,0"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="14"/>
                        <ComboBox x:Name="ModelArchComboBox" 
                                  Width="200" 
                                  Height="32" 
                                  SelectionChanged="ModelArchComboBox_SelectionChanged"
                                  Background="{StaticResource CardBackground}"
                                  Foreground="{StaticResource ForegroundBrush}"
                                  BorderBrush="{StaticResource PanelBorderBrush}"
                                  FontSize="14">
                            <ComboBoxItem Content="YOLOv8n"/>
                            <ComboBoxItem Content="YOLOv8s"/>
                            <ComboBoxItem Content="YOLOv8m"/>
                            <ComboBoxItem Content="YOLOv8l"/>
                            <ComboBoxItem Content="YOLOv8x"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ✅ Training Canvas with dark theme -->
            <Border Grid.Row="1"
                    Background="{StaticResource CardBackground}"
                    CornerRadius="8"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="2"
                    Padding="12"
                    SnapsToDevicePixels="True"
                    Effect="{StaticResource ShadowEffect}">
                <Canvas x:Name="TrainingCanvas"
                        AllowDrop="True"
                        ClipToBounds="True"
                        Background="Transparent"/>
            </Border>

            <!-- ✅ Footer Controls with dark theme -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,20,0,10">
                <TextBlock x:Name="TrainingStatusText"
                           Text="🧠 Drag blocks to build your training pipeline"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0"/>

                <Button x:Name="TrainModelButton"
                        Content="🚀 Train Model"
                        Width="180"
                        Height="48"
                        FontWeight="Bold"
                        FontSize="16"
                        Background="#4CAF50"
                        Foreground="White"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="2"
                        Cursor="Hand"
                        Click="TrainModelButton_Click"
                        Margin="0,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                Padding="12"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#45A049"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </DockPanel>
</Page>