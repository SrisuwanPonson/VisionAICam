<Page x:Class="VisionAICam.Pages.ModelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:VisionAICam.Pages"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="ModelPage">

    <!-- 🌫️ Gradient Background -->
    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#263238" Offset="0"/>
            <GradientStop Color="#37474F" Offset="0.5"/>
            <GradientStop Color="#263238" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>

    <Page.Resources>
        <DropShadowEffect x:Key="ShadowEffect"
                          Color="Black"
                          Direction="270"
                          ShadowDepth="4"
                          Opacity="0.3"
                          BlurRadius="8"/>
    </Page.Resources>

    <DockPanel LastChildFill="True">
        <!-- 🧭 Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="#FFFFFF" Foreground="#333">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="Padding" Value="12,6"/>
                    <Setter Property="Margin" Value="2"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#333"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#E3F2FD"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Menu.Resources>
            <MenuItem Header="File">
                <MenuItem Header="New Project" Click="NewModel_Click"/>
                <MenuItem Header="Open Project" Click="OpenModel_Click"/>
                <Separator/>
                <MenuItem Header="Save Project" Click="SaveModel_Click"/>
                <MenuItem Header="Export Project" Click="ExportModel_Click"/>
                <MenuItem Header="Close Project" Click="CloseModel_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="Undo" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
                <MenuItem Header="Redo" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem Header="Full Screen" InputGestureText="F11" Click="FullScreenToggleButton_Click"/>
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="View Help" Click="ViewHelp_Click"/>
                <MenuItem Header="About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- 🧠 Main Workspace -->
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 🔧 Model Training Configuration Panel (wrapped for visibility control) -->
            <Grid x:Name="ConfigPanelGrid" Grid.Row="0" Visibility="Collapsed">
                <Border
                    Background="#FAFAFA"
                    CornerRadius="8"
                    BorderBrush="#DDD"
                    BorderThickness="1"
                    Padding="18,12"
                    Margin="0,0,0,10"
                    Effect="{StaticResource ShadowEffect}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Project Type ComboBox -->
                        <TextBlock Text="Project:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="ProjectTypeComboBox" Width="180" Margin="0,0,12,0" SelectionChanged="ProjectTypeComboBox_SelectionChanged">
                            <ComboBoxItem Content="Object Detection" IsSelected="True"/>
                            <ComboBoxItem Content="Image Classification"/>
                            <ComboBoxItem Content="Defect Detection"/>
                        </ComboBox>

                        <TextBlock Text="Dataset:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="DatasetComboBox" Width="160" Margin="0,0,12,0"/>
                        <Button Content="Browse..." Width="80" Click="BrowseDataset_Click" Margin="0,0,18,0"/>

                        <TextBlock Text="Model:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <!-- Architecture ComboBox -->
                        <ComboBox x:Name="ModelArchComboBox" Width="200" Height="30" SelectionChanged="ModelArchComboBox_SelectionChanged">
                            <ComboBoxItem Content="YOLOv5n"/>
                            <ComboBoxItem Content="YOLOv5s"/>
                            <ComboBoxItem Content="YOLOv5m"/>
                            <ComboBoxItem Content="YOLOv5l"/>
                            <ComboBoxItem Content="YOLOv5x"/>
                            <ComboBoxItem Content="YOLOv8n"/>
                            <ComboBoxItem Content="YOLOv8s"/>
                            <ComboBoxItem Content="YOLOv8m"/>
                            <ComboBoxItem Content="YOLOv8l"/>
                            <ComboBoxItem Content="YOLOv8x"/>
                            <ComboBoxItem Content="Faster R-CNN"/>
                            <ComboBoxItem Content="SSD"/>
                            <ComboBoxItem Content="RetinaNet"/>
                            <ComboBoxItem Content="EfficientDet"/>
                            <ComboBoxItem Content="CenterNet"/>
                            <ComboBoxItem Content="YOLOv4"/>
                            <ComboBoxItem Content="YOLOv3"/>
                            <ComboBoxItem Content="YOLOv7"/>
                            <ComboBoxItem Content="DETR"/>
                            <ComboBoxItem Content="Cascade R-CNN"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 🎯 Training Canvas -->
            <Border Grid.Row="1"
                    Background="#FAFAFA"
                    CornerRadius="8"
                    BorderBrush="#DDD"
                    BorderThickness="1"
                    Padding="10"
                    SnapsToDevicePixels="True"
                    Effect="{StaticResource ShadowEffect}">
                <Canvas x:Name="TrainingCanvas"
                        AllowDrop="True"
                        ClipToBounds="True"/>
            </Border>

            <!-- 🚀 Footer Controls -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,20,10,10">
                <TextBlock x:Name="TrainingStatusText"
                           Text="🧠 Drag blocks to build your training pipeline"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#1976D2"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0"/>

                <Button x:Name="TrainModelButton"
                        Content="🚀 Train Model"
                        Width="160"
                        Height="48"
                        FontWeight="Bold"
                        Background="#1976D2"
                        Foreground="White"
                        Cursor="Hand"
                        Click="TrainModelButton_Click"
                        Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="10"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1565C0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </DockPanel>
</Page>
