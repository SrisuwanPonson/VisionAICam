<Page x:Class="VisionAICam.Pages.ModelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VisionAICam.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="ModelPage"
      Focusable="True"
      KeyDown="Page_KeyDown">

    <Grid x:Name="MainLayoutGrid" Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Help/Guide Panel -->
        <Expander Header="How to Prepare and Annotate Data (Click to expand)" 
                  IsExpanded="False"
                  Background="#FFFDE7"
                  BorderBrush="#FFD54F"
                  BorderThickness="1"
                  Margin="0,0,0,20"
                  Grid.Row="0"
                  x:Name="HelpExpander">
            <StackPanel Margin="10">
                <TextBlock Text="Step 1: Load a Folder" FontWeight="Bold" />
                <TextBlock Text="Click 'Load Folder' to select a folder of images for annotation." TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="Step 2: Manage Labels" FontWeight="Bold" />
                <TextBlock Text="Select or add a label from the dropdown before drawing boxes." TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="Step 3: Annotate" FontWeight="Bold" />
                <TextBlock Text="Drag on the image to draw a bounding box. Click 'Add Box' to save the box with the selected label." TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="Step 4: Edit or Remove" FontWeight="Bold" />
                <TextBlock Text="Select a box in the list to remove it if needed." TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="Step 5: Save" FontWeight="Bold" />
                <TextBlock Text="Click 'Save Annotations' to save your work for the current image." TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="Step 6: Export" FontWeight="Bold" />
                <TextBlock Text="When finished, click 'Export YOLO' to export all annotations in Roboflow/YOLO format." TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="Tip: Use 'Previous' and 'Next' to navigate images. Progress is shown above the image." FontStyle="Italic" Foreground="Gray" Margin="0,8,0,0"/>
            </StackPanel>
        </Expander>

        <!-- Title and Navigation -->
        <StackPanel x:Name="TitlePanel" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="Data Preparation"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,20,0"/>
            <Button Content="Load Folder" Width="120" Margin="0,0,10,0" Click="LoadFolder_Click"/>
            <Button Content="Previous" Width="100" Margin="0,0,10,0" Click="PrevImage_Click"/>
            <Button Content="Next" Width="100" Margin="0,0,10,0" Click="NextImage_Click"/>
            <TextBlock x:Name="ImageProgressText" Text="No images loaded" FontSize="16" VerticalAlignment="Center" Margin="20,0,0,0"/>
        </StackPanel>

        <!-- Model Details -->
        <StackPanel x:Name="ModelDetailsPanel" Grid.Row="2" Orientation="Vertical" Margin="0,0,0,20">
            <TextBlock Text="Model Details:" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock x:Name="ModelDetailsText" Text="No model loaded." FontSize="14" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Image Labeling Section -->
        <Border x:Name="ImageAreaContainer" Grid.Row="3" BorderBrush="#90CAF9" BorderThickness="2" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <!-- Image Viewer with Overlay -->
                <Border Margin="0,0,16,0" BorderBrush="#B0BEC5" BorderThickness="1.5" CornerRadius="8" Background="#FAFAFA">
                    <Grid>
                        <!-- Full Screen Toggle Button -->
                        <Button x:Name="FullScreenToggleButton"
                                Content="⤢"
                                Width="36"
                                Height="36"
                                ToolTip="Toggle Full Screen"
                                Click="FullScreenToggleButton_Click"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,8,8,0"
                                Panel.ZIndex="10"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Image x:Name="LabelingImage"
                                       Stretch="Uniform"
                                       RenderTransformOrigin="0.5,0.5"/>
                                <Canvas x:Name="BoundingBoxCanvas"
                                        Background="Transparent"
                                        IsHitTestVisible="True"/>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <!-- Annotation Controls -->
                <StackPanel x:Name="AnnotationPanel" Grid.Column="1" Margin="0,0,0,0" VerticalAlignment="Stretch">
                    <TextBlock Text="Annotations" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ListView x:Name="AnnotationListView" Height="200" Margin="0,0,0,10">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Label" Width="80" DisplayMemberBinding="{Binding Label}"/>
                                <GridViewColumn Header="X1" Width="50" DisplayMemberBinding="{Binding X1}"/>
                                <GridViewColumn Header="Y1" Width="50" DisplayMemberBinding="{Binding Y1}"/>
                                <GridViewColumn Header="X2" Width="50" DisplayMemberBinding="{Binding X2}"/>
                                <GridViewColumn Header="Y2" Width="50" DisplayMemberBinding="{Binding Y2}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Label:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="LabelComboBox" Width="120" Margin="5,0"/>
                        <Button Content="Add Box" Margin="10,0" Width="80" Click="AddBox_Click"/>
                        <Button Content="Remove Selected" Margin="10,0" Width="120" Click="RemoveSelected_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Save Annotations" Width="140" Margin="0,0,10,0" Click="SaveAnnotations_Click"/>
                        <Button Content="Export YOLO" Width="120" Margin="0,0,10,0" Click="ExportYolo_Click"/>
                    </StackPanel>
                    <TextBlock Text="Tip: Drag to draw a box. Select a label before saving." FontStyle="Italic" Foreground="Gray"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Progress Overlay -->
        <Grid x:Name="ProgressOverlay"
              Background="#80000000"
              Visibility="Collapsed"
              Panel.ZIndex="100">
            <Border CornerRadius="8" Background="White" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="ProgressMessage" Text="Please wait..." FontSize="16" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Height="20" Width="200"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
