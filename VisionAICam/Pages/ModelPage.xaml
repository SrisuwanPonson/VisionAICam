<Page x:Class="VisionAICam.Pages.ModelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VisionAICam.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="ModelPage">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="Model Management"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,20"
                   Grid.Row="0"/>

        <!-- Model Selection, Load, and Train -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Top"
                    Margin="0,0,0,20">
            <TextBlock Text="Default Model for Running:"
                       FontSize="16"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="CurrentModelPathText"
                       Text="(none selected)"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="10,0"/>
            <Button Content="Select Model for Running..."
                    Margin="20,0,0,0"
                    Padding="16,4"
                    Click="SelectModelForRunningButton_Click"/>
            <Button Content="Set as Default"
                    Margin="10,0,0,0"
                    Padding="16,4"
                    Click="SetAsDefaultModelButton_Click"/>
            <Button Content="Load Pre-trained Model..."
                    Margin="10,0,0,0"
                    Padding="16,4"
                    Click="LoadModelButton_Click"/>
            <Button Content="Download Dataset..."
                    Margin="10,0,0,0"
                    Padding="16,4"
                    Click="DownloadDatasetButton_Click"/>
            <Button Content="Train Model..."
                    Margin="10,0,0,0"
                    Padding="16,4"
                    Click="TrainModelButton_Click"/>
            <Button Content="Test Model with Python.NET"
                    Margin="10,0,0,0"
                    Padding="16,4"
                    Click="TestModelWithPythonNetButton_Click"/>
        </StackPanel>

        <!-- Fine-tune Options (collapsible) -->
        <Expander Header="Fine-tune Options" Grid.Row="2" Margin="0,0,0,20" IsExpanded="False">
            <StackPanel Orientation="Vertical" Margin="10">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Epochs:" Width="100" VerticalAlignment="Center"/>
                    <TextBox x:Name="EpochsTextBox" Width="60" Text="50" Margin="10,0,0,0"/>
                    <TextBlock Text="Batch Size:" Width="100" Margin="20,0,0,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="BatchSizeTextBox" Width="60" Text="16" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Learning Rate:" Width="100" VerticalAlignment="Center"/>
                    <TextBox x:Name="LearningRateTextBox" Width="60" Text="0.01" Margin="10,0,0,0"/>
                    <TextBlock Text="Image Size:" Width="100" Margin="20,0,0,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="ImageSizeTextBox" Width="60" Text="640" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Pretrained Weights:" Width="100" VerticalAlignment="Center"/>
                    <TextBox x:Name="PretrainedWeightsTextBox" Width="200" Text="yolov8n.pt" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Expander>

        <!-- Model Details -->
        <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,0,0,20">
            <TextBlock Text="Model Details:"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>
            <TextBlock x:Name="ModelDetailsText"
                       Text="No model loaded."
                       FontSize="14"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Training Status -->
        <StackPanel Grid.Row="4" Orientation="Vertical">
            <TextBlock Text="Training Status:"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>
            <TextBlock x:Name="TrainingStatusText"
                       Text="No training in progress."
                       FontSize="14"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Progress Overlay -->
        <Grid x:Name="ProgressOverlay"
              Background="#80000000"
              Visibility="Collapsed"
              Panel.ZIndex="100">
            <Border CornerRadius="8" Background="White" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="ProgressMessage" Text="Please wait..." FontSize="16" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Height="20" Width="200"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
