<Page x:Class="VisionAICam.Pages.DataPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="DataPage">

    <Page.Resources>
        <!-- Light background gradient -->
        <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5F5F5" Offset="0"/>
            <GradientStop Color="#E0E0E0" Offset="1"/>
        </LinearGradientBrush>

        <!-- Text styling -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Border styling -->
        <Style TargetType="Border">
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFAFA"/>
        </Style>

        <!-- Button styling -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <!-- DataGrid styling -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowBackground" Value="#F9F9F9"/>
            <Setter Property="AlternatingRowBackground" Value="#EFEFEF"/>
        </Style>
    </Page.Resources>

    <Page.Background>
        <StaticResource ResourceKey="PageBackgroundBrush"/>
    </Page.Background>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Page Title -->
        <TextBlock Text="Data Overview"
                   FontSize="30"
                   FontWeight="Bold"
                   Margin="0,0,0,20"
                   Grid.ColumnSpan="2"
                   Grid.Row="0"/>

        <!-- Search/Filter Controls -->
        <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="SearchTextBox" Width="200" Margin="0,0,10,0"/>
            <Button Content="Filter" Width="80" Click="FilterButton_Click"/>
            <Button Content="Export" Width="80" Click="ExportButton_Click"/>
            <Button Content="Delete Selected" Width="120" Click="DeleteButton_Click"/>
        </StackPanel>

        <!-- Data Table -->
        <GroupBox Header="Detection Records" Grid.Row="2" Grid.Column="0" Margin="0,0,20,0">
            <DataGrid x:Name="DataGrid"
                      AutoGenerateColumns="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      Margin="10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="*"/>
                    <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="*"/>
                    <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="*"/>
                    <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Preview Panel -->
        <GroupBox Header="Preview Details" Grid.Row="2" Grid.Column="1">
            <StackPanel Margin="10">
                <Border Margin="0,0,0,10">
                    <Image x:Name="PreviewImage" Height="200" Stretch="Uniform"/>
                </Border>
                <TextBlock x:Name="DetailsTextBlock"
                           Text="Select a row to see details."
                           TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Page>