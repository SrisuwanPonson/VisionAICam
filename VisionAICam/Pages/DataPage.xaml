<Page x:Class="VisionAICam.Pages.DataPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:VisionAICam.Pages"
      Title="DataPage">

    <Page.Resources>
        <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5F5F5" Offset="0"/>
            <GradientStop Color="#E0E0E0" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="Border">
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFAFA"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowBackground" Value="#F9F9F9"/>
            <Setter Property="AlternatingRowBackground" Value="#EFEFEF"/>
        </Style>

        <!-- Converter for ClassId display (DetectionResult or PredictionEntity) -->
        <local:ClassIdConverter x:Key="ClassIdConverter"/>
    </Page.Resources>

    <Page.Background>
        <StaticResource ResourceKey="PageBackgroundBrush"/>
    </Page.Background>

    <Grid Margin="24">
        <TabControl>

            <!-- 📋 Tab 1: Records -->
            <TabItem Header="Records">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="SearchTextBox" Width="200" Margin="0,0,10,0"/>
                        <Button Content="Filter" Width="80" Click="FilterButton_Click"/>
                        <Button Content="Refresh" Width="80" Click="RefreshButton_Click" Margin="8,0,0,0"/>
                        <Button Content="Load DB" Width="80" Click="LoadDbButton_Click" Margin="8,0,0,0"/>
                        <Button Content="Export" Width="80" Click="ExportButton_Click" Margin="8,0,0,0"/>
                        <Button Content="Delete Selected" Width="120" Click="DeleteButton_Click" Margin="8,0,0,0"/>
                    </StackPanel>

                    <DataGrid x:Name="ResultsGrid"
                              AutoGenerateColumns="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              Height="360"
                              DockPanel.Dock="Top"
                              Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Timestamp"
                                                Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                Width="160"/>
                            <DataGridTextColumn Header="Class Name"
                                                Binding="{Binding ClassName}"
                                                Width="150"/>

                            <!-- Class ID column (works for DetectionResult or PredictionEntity) -->
                            <DataGridTemplateColumn Header="Class ID" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource ClassIdConverter}}"
                                                   VerticalAlignment="Center"
                                                   Padding="4,0,4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Box Position"
                                                Binding="{Binding Box}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Confidence"
                                                Binding="{Binding Confidence, StringFormat={}{0:P2}}"
                                                Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>

                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Delete" Click="DeleteButton_Click"/>
                                <MenuItem Header="Show Details" Click="ShowDetailsContext_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>

                    <StatusBar DockPanel.Dock="Bottom">
                        <StatusBarItem>
                            <TextBlock x:Name="TotalRecordsText" Text="Total Records: 0"/>
                        </StatusBarItem>
                        <StatusBarItem Margin="12,0,0,0">
                            <TextBlock x:Name="AverageConfidenceText" Text="Average Confidence: N/A"/>
                        </StatusBarItem>
                        <StatusBarItem Margin="12,0,0,0">
                            <TextBlock x:Name="ClassBreakdownText" Text="Detected Classes: None"/>
                        </StatusBarItem>
                        <StatusBarItem Margin="12,0,0,0">
                            <TextBlock x:Name="ErrorCountText" Text="Error Events: 0"/>
                        </StatusBarItem>
                        <StatusBarItem Margin="12,0,0,0">
                            <TextBlock x:Name="ModeText" Text="Mode: Live"/>
                        </StatusBarItem>
                    </StatusBar>
                </DockPanel>
            </TabItem>

            <!-- 🔍 Tab 2: Preview -->
            <TabItem Header="Preview">
                <StackPanel Margin="12">
                    <TextBlock Text="Preview Details" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Border BorderBrush="#CCC" BorderThickness="1" Background="White" Height="220">
                        <Image x:Name="PreviewImage" Stretch="Uniform"/>
                    </Border>
                    <TextBlock x:Name="DetailsTextBlock" Text="Select a row to see details." TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- ⚠️ Tab 3: Errors -->
            <TabItem Header="Errors">
                <StackPanel Margin="12">
                    <TextBlock Text="Error Events" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                    <ListView x:Name="ErrorListView" Height="300">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Timestamp" DisplayMemberBinding="{Binding Timestamp}" Width="150"/>
                                <GridViewColumn Header="File Name" DisplayMemberBinding="{Binding FileName}" Width="200"/>
                                <GridViewColumn Header="Error Type" DisplayMemberBinding="{Binding ErrorType}" Width="150"/>
                                <GridViewColumn Header="Message" DisplayMemberBinding="{Binding Message}" Width="300"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </TabItem>

            <!-- 📊 Tab 4: Statistics -->
            <TabItem Header="Statistics">
                <StackPanel Margin="12">
                    <TextBlock Text="Record Summary" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock x:Name="StatTotalRecordsText" Text="Total Records: 0" Margin="0,6"/>
                    <TextBlock x:Name="StatAverageConfidenceText" Text="Average Confidence: N/A" Margin="0,6"/>
                    <TextBlock x:Name="StatClassBreakdownText" Text="Detected Classes: None" Margin="0,6"/>
                </StackPanel>
            </TabItem>

            <!-- 📈 Tab 5: Graph -->
            <TabItem Header="Graph">
                <StackPanel Margin="12">
                    <TextBlock Text="Confidence Distribution" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Border Background="White" BorderBrush="#CCC" BorderThickness="1" Height="300">
                        <TextBlock Text="Graph placeholder (e.g., histogram or pie chart)"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#999"/>
                    </Border>
                </StackPanel>
            </TabItem>

        </TabControl>
    </Grid>
</Page>