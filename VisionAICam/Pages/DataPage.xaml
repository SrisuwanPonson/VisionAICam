<Page x:Class="VisionAICam.Pages.DataPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:VisionAICam.Pages"
      Title="DataPage">

    <Page.Resources>
        <!-- ✅ Dark theme palette matching other pages -->
        <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#263238" Offset="0"/>
            <GradientStop Color="#37474F" Offset="0.5"/>
            <GradientStop Color="#263238" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="PanelBackground" Color="#37474F"/>
        <SolidColorBrush x:Key="CardBackground" Color="#263238"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#1976D2"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFD700"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryForeBrush" Color="#B0BEC5"/>

        <!-- ✅ TextBlock style -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- ✅ Border style -->
        <Style TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        </Style>

        <!-- ✅ Button style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2196F3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ✅ TextBox style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- ✅ DataGrid style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowBackground" Value="{StaticResource PanelBackground}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ColumnHeaderHeight" Value="32"/>
        </Style>

        <!-- ✅ TabControl style -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- ✅ TabItem style -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,6"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource CardBackground}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ✅ StatusBar style -->
        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryForeBrush}"/>
        </Style>

        <!-- ✅ ListView style -->
        <Style TargetType="ListView">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Converter for ClassId display (DetectionResult or PredictionEntity) -->
        <local:ClassIdConverter x:Key="ClassIdConverter"/>
    </Page.Resources>

    <Page.Background>
        <StaticResource ResourceKey="PageBackgroundBrush"/>
    </Page.Background>

    <Grid Margin="24">
        <TabControl>

            <!-- 📋 Tab 1: Records -->
            <TabItem Header="📋 Records">
                <DockPanel Margin="16">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="🔍 Search:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                        <TextBox x:Name="SearchTextBox" Width="220" Margin="0,0,10,0"/>
                        <Button Content="Filter" Width="80" Click="FilterButton_Click"/>
                        <Button Content="🔄 Refresh" Width="90" Click="RefreshButton_Click"/>
                        <Button Content="📂 Load DB" Width="90" Click="LoadDbButton_Click"/>
                        <Button Content="📤 Export" Width="80" Click="ExportButton_Click"/>
                        <Button Content="🗑️ Delete" Width="100" Click="DeleteButton_Click" Background="#F44336"/>
                    </StackPanel>

                    <DataGrid x:Name="ResultsGrid"
                              AutoGenerateColumns="False"
                              SelectionMode="Single"
                              IsReadOnly="True"
                              Height="400"
                              DockPanel.Dock="Top"
                              Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Timestamp"
                                                Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                Width="160"/>
                            <DataGridTextColumn Header="Class Name"
                                                Binding="{Binding ClassName}"
                                                Width="150"/>

                            <!-- Class ID column (works for DetectionResult or PredictionEntity) -->
                            <DataGridTextColumn Header="Class ID" Width="90" Binding="{Binding ClassId}"/>

                            <DataGridTextColumn Header="Box Position"
                                                Binding="{Binding Box}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Confidence"
                                                Binding="{Binding Confidence, StringFormat={}{0:P2}}"
                                                Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,6,0"/>
                                        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>

                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="🗑️ Delete" Click="DeleteButton_Click"/>
                                <MenuItem Header="ℹ️ Show Details" Click="ShowDetailsContext_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>

                    <StatusBar DockPanel.Dock="Bottom">
                        <StatusBarItem>
                            <TextBlock x:Name="TotalRecordsText" Text="Total Records: 0"/>
                        </StatusBarItem>
                        <StatusBarItem Margin="12,0,0,0">
                            <TextBlock x:Name="AverageConfidenceText" Text="Average Confidence: N/A"/>
                        </StatusBarItem>
                        <StatusBarItem Margin="12,0,0,0">
                            <TextBlock x:Name="ClassBreakdownText" Text="Detected Classes: None"/>
                        </StatusBarItem>
                        <StatusBarItem Margin="12,0,0,0">
                            <TextBlock x:Name="ErrorCountText" Text="Error Events: 0"/>
                        </StatusBarItem>
                        <StatusBarItem Margin="12,0,0,0">
                            <TextBlock x:Name="ModeText" Text="Mode: Live"/>
                        </StatusBarItem>
                    </StatusBar>
                </DockPanel>
            </TabItem>

            <!-- 🔍 Tab 2: Preview -->
            <TabItem Header="🔍 Preview">
                <StackPanel Margin="16">
                    <TextBlock Text="Preview Details" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,16"/>
                    <Border Height="380" Padding="8">
                        <Image x:Name="PreviewImage" Stretch="Uniform"/>
                    </Border>
                    <TextBlock x:Name="DetailsTextBlock" Text="Select a row to see details." TextWrapping="Wrap" Margin="0,16,0,0" FontSize="14"/>
                </StackPanel>
            </TabItem>

            <!-- ⚠️ Tab 3: Errors -->
            <TabItem Header="⚠️ Errors">
                <StackPanel Margin="16">
                    <TextBlock Text="Error Events" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,16"/>
                    <ListView x:Name="ErrorListView" Height="400">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Timestamp" DisplayMemberBinding="{Binding Timestamp}" Width="160"/>
                                <GridViewColumn Header="File Name" DisplayMemberBinding="{Binding FileName}" Width="220"/>
                                <GridViewColumn Header="Error Type" DisplayMemberBinding="{Binding ErrorType}" Width="150"/>
                                <GridViewColumn Header="Message" DisplayMemberBinding="{Binding Message}" Width="400"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </TabItem>

            <!-- 📊 Tab 4: Statistics -->
            <TabItem Header="📊 Statistics">
                <StackPanel Margin="16">
                    <TextBlock Text="Record Summary" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,16"/>
                    <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="2" Padding="16" CornerRadius="6">
                        <StackPanel>
                            <TextBlock x:Name="StatTotalRecordsText" Text="Total Records: 0" Margin="0,8" FontSize="16"/>
                            <TextBlock x:Name="StatAverageConfidenceText" Text="Average Confidence: N/A" Margin="0,8" FontSize="16"/>
                            <TextBlock x:Name="StatClassBreakdownText" Text="Detected Classes: None" Margin="0,8" FontSize="16"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- 📈 Tab 5: Graph -->
            <TabItem Header="📈 Graph">
                <StackPanel Margin="16">
                    <TextBlock Text="Confidence Distribution" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,16"/>
                    <Border Height="400" Padding="16">
                        <TextBlock Text="📊 Graph placeholder (histogram or pie chart)"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   Foreground="{StaticResource SecondaryForeBrush}"/>
                    </Border>
                </StackPanel>
            </TabItem>

        </TabControl>
    </Grid>
</Page>