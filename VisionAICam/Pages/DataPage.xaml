<Page x:Class="VisionAICam.Pages.DataPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="DataPage">

    <Page.Resources>
        <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5F5F5" Offset="0"/>
            <GradientStop Color="#E0E0E0" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="Border">
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFAFA"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowBackground" Value="#F9F9F9"/>
            <Setter Property="AlternatingRowBackground" Value="#EFEFEF"/>
        </Style>
    </Page.Resources>

    <Page.Background>
        <StaticResource ResourceKey="PageBackgroundBrush"/>
    </Page.Background>

    <Grid Margin="24">
        <TabControl>

            <!-- 📋 Tab 1: Records -->
            <TabItem Header="Records">
                <StackPanel Margin="12">
                    <TextBlock Text="Detection Records" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="SearchTextBox" Width="200" Margin="0,0,10,0"/>
                        <Button Content="Filter" Width="80" Click="FilterButton_Click"/>
                        <Button Content="Export" Width="80" Click="ExportButton_Click"/>
                        <Button Content="Delete Selected" Width="120" Click="DeleteButton_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="ResultsGrid"
                              AutoGenerateColumns="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              Height="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="*"/>
                            <DataGridTextColumn Header="Class Name" Binding="{Binding ClassName}" Width="*"/>
                            <DataGridTextColumn Header="Box Position" Binding="{Binding Box}" Width="*"/>
                            <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>

            <!-- 🔍 Tab 2: Preview -->
            <TabItem Header="Preview">
                <StackPanel Margin="12">
                    <TextBlock Text="Preview Details" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Image x:Name="PreviewImage" Height="200" Stretch="Uniform" Margin="0,0,0,12"/>
                    <TextBlock x:Name="DetailsTextBlock"
                               Text="Select a row to see details."
                               TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>

            <!-- ⚠️ Tab 3: Errors -->
            <TabItem Header="Errors">
                <StackPanel Margin="12">
                    <TextBlock Text="Error Events" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                    <ListView x:Name="ErrorListView" Height="300">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Timestamp" DisplayMemberBinding="{Binding Timestamp}" Width="150"/>
                                <GridViewColumn Header="File Name" DisplayMemberBinding="{Binding FileName}" Width="200"/>
                                <GridViewColumn Header="Error Type" DisplayMemberBinding="{Binding ErrorType}" Width="150"/>
                                <GridViewColumn Header="Message" DisplayMemberBinding="{Binding Message}" Width="300"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </TabItem>

            <!-- 📊 Tab 4: Statistics -->
            <TabItem Header="Statistics">
                <StackPanel Margin="12">
                    <TextBlock Text="Record Summary" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock x:Name="TotalRecordsText" Text="Total Records: 0"/>
                    <TextBlock x:Name="ErrorCountText" Text="Error Events: 0"/>
                    <TextBlock x:Name="AverageConfidenceText" Text="Average Confidence: N/A"/>
                    <TextBlock x:Name="ClassBreakdownText" Text="Detected Classes: None"/>
                </StackPanel>
            </TabItem>

            <!-- 📈 Tab 5: Graph -->
            <TabItem Header="Graph">
                <StackPanel Margin="12">
                    <TextBlock Text="Confidence Distribution" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Border Background="White" BorderBrush="#CCC" BorderThickness="1" Height="300">
                        <TextBlock Text="Graph placeholder (e.g., histogram or pie chart)"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#999"/>
                    </Border>
                </StackPanel>
            </TabItem>

        </TabControl>
    </Grid>
</Page>