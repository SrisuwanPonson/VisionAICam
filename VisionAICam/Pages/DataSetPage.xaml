<Page x:Class="VisionAICam.Pages.DataSetPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VisionAICam.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="ModelPage"
      Focusable="True"
      KeyDown="Page_KeyDown"
      Background="Transparent">

    <Page.Resources>
        <!-- ✅ Dark theme palette matching CameraPage -->
        <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#263238" Offset="0"/>
            <GradientStop Color="#37474F" Offset="0.5"/>
            <GradientStop Color="#263238" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="PanelBackground" Color="#37474F"/>
        <SolidColorBrush x:Key="CardBackground" Color="#263238"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#1976D2"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFD700"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryForeBrush" Color="#B0BEC5"/>
    </Page.Resources>

    <DockPanel LastChildFill="True" Background="{StaticResource PageBackgroundBrush}">
        <!-- ✅ Menu Bar with dark theme -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource PanelBackground}" Foreground="{StaticResource ForegroundBrush}">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
                    <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
                    <Setter Property="Margin" Value="2"/>
                </Style>
            </Menu.Resources>
            
            <MenuItem Header="📁 File">
                <MenuItem Header="New Project" Click="CreateProject_Click"/>
                <MenuItem Header="Open Project" Click="OpenProject_Click"/>
                <Separator/>
                <MenuItem Header="Save Project" Click="SaveProject_Click"/>
                <MenuItem Header="Export YOLO">
                    <MenuItem Header="Export YOLOv5"
                              Click="ExportYoloV5_Click"
                              ToolTip="YOLOv5: ⚙️ Stable and widely used for detection tasks. Great for legacy workflows."/>
                    <MenuItem Header="Export YOLOv5_OBB"
                                Click="ExportYoloV5_OBB_Click"
                                ToolTip="YOLOv5_OBB: 📐 Oriented Bounding Boxes for rotated objects. Ideal for aerial imagery and text detection."/>
                    <MenuItem Header="Export YOLOv8"
                              Click="ExportYoloV8_Click"
                              ToolTip="YOLOv8: 🚀 Latest version with better speed, accuracy, and support for new features."/>
                    <MenuItem Header="Export YOLOv8_OBB"
                              Click="ExportYoloV8_OBB_Click"
                                ToolTip="YOLOv8_OBB: 📐 Oriented Bounding Boxes with the advancements of YOLOv8."/>
                    <MenuItem Header="Export YOLOv8_SEG"
                              Click="ExportYoloV8_SEG_Click"
                                ToolTip="YOLOv8_SEG: 🖌️ Segmentation support for pixel-level object annotation. Ideal for advanced tasks like instance segmentation."/>
                </MenuItem>
                <MenuItem Header="Close Project" Click="CloseProject_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="✏️ Edit">
                <MenuItem Header="Undo" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
                <MenuItem Header="Redo" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
                <Separator/>
                <MenuItem Header="Remove Selected" Click="RemoveSelected_Click"/>
            </MenuItem>
            <MenuItem Header="👁️ View">
                <MenuItem Header="Zoom In" InputGestureText="Ctrl++" Click="ZoomIn_Click"/>
                <MenuItem Header="Zoom Out" InputGestureText="Ctrl+-" Click="ZoomOut_Click"/>
                <MenuItem Header="Full Screen" InputGestureText="F11" Click="FullScreenToggleButton_Click"/>
                <MenuItem Header="Processing Panel" x:Name="ToggleProcessingPanelMenu" IsCheckable="True" Click="ToggleProcessingPanelMenu_Click" InputGestureText="Ctrl+P"/>
            </MenuItem>
            <MenuItem Header="❓ Help">
                <MenuItem Header="View Help" Click="ViewHelp_Click"/>
                <MenuItem Header="About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- ✅ Status Bar with dark theme -->
        <StatusBar DockPanel.Dock="Bottom" FontSize="13" Background="{StaticResource CardBackground}" Foreground="{StaticResource SecondaryForeBrush}">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Ready" />
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content with scrollbars -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="MainLayoutGrid" Margin="30" Background="Transparent">
                <!-- Main Content Panel -->
                <Grid x:Name="MainContentPanel" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ✅ Title and Navigation with dark theme -->
                    <StackPanel x:Name="TitlePanel" Grid.Row="0" Orientation="Vertical" VerticalAlignment="Top" Margin="0,0,0,8">
                        <TextBlock FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,0,0,6">
                            <Run Text="📊 "/>
                            <Run Text="Data Preparation"/>
                        </TextBlock>

                        <!-- ✅ Image Navigation with dark theme -->
                        <GroupBox Margin="0,0,0,4" 
                                  Foreground="{StaticResource AccentBrush}" 
                                  Background="{StaticResource PanelBackground}" 
                                  BorderBrush="{StaticResource PanelBorderBrush}"
                                  BorderThickness="2">
                            <GroupBox.Header>
                                <TextBlock FontWeight="Bold">
                                    <Run Text="🖼️ "/>
                                    <Run Text="Image Navigation"/>
                                </TextBlock>
                            </GroupBox.Header>
                            <StackPanel Orientation="Horizontal" Margin="10,4,10,4" Background="{StaticResource PanelBackground}">
                                <Button MinWidth="100" Click="LoadFolder_Click" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📂 " VerticalAlignment="Center"/>
                                        <TextBlock Text="Load Folder" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button MinWidth="80" Click="PrevImage_Click" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◀ " VerticalAlignment="Center"/>
                                        <TextBlock Text="Previous" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button MinWidth="80" Click="NextImage_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="▶ " VerticalAlignment="Center"/>
                                        <TextBlock Text="Next" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="ImageProgressText" 
                                           Text="No images loaded" 
                                           FontSize="16" 
                                           Foreground="{StaticResource ForegroundBrush}" 
                                           VerticalAlignment="Center" 
                                           Margin="20,0,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- ✅ Controls Row with dark theme -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <!-- Class Management -->
                            <GroupBox Foreground="{StaticResource AccentBrush}"
                                      Background="{StaticResource PanelBackground}"
                                      BorderBrush="{StaticResource PanelBorderBrush}"
                                      BorderThickness="2"
                                      VerticalAlignment="Top"
                                      MinWidth="500"
                                      MaxWidth="800"
                                      Height="80"
                                      Margin="0,0,10,0">
                                <GroupBox.Header>
                                    <TextBlock FontWeight="Bold">
                                        <Run Text="🏷️ "/>
                                        <Run Text="Class Management"/>
                                    </TextBlock>
                                </GroupBox.Header>
                                <StackPanel Orientation="Horizontal" 
                                            Margin="10,8,10,8" 
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Label:" 
                                               VerticalAlignment="Center" 
                                               Foreground="{StaticResource ForegroundBrush}" 
                                               Margin="0,0,8,0"/>
                                    <ComboBox x:Name="LabelComboBox" 
                                              MinWidth="120"
                                              MaxWidth="200"
                                              VerticalAlignment="Center"
                                              Margin="0,0,16,0"/>
                                
                                    <TextBox x:Name="NewClassTextBox" 
                                             MinWidth="120"
                                             MaxWidth="200"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0"
                                             Height="26"/>
                                
                                    <Button Content="➕ Add Class" 
                                            Click="AddClassButton_Click"
                                            VerticalAlignment="Center"
                                            Height="26"
                                            Padding="8,0"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Drawing Mode -->
                            <GroupBox Foreground="{StaticResource AccentBrush}"
                                      Background="{StaticResource PanelBackground}"
                                      BorderBrush="{StaticResource PanelBorderBrush}"
                                      BorderThickness="2"
                                      VerticalAlignment="Top"
                                      MinWidth="200"
                                      MaxWidth="350"
                                      Height="80"
                                      Margin="0,0,10,0">
                                <GroupBox.Header>
                                    <TextBlock FontWeight="Bold">
                                        <Run Text="✏️ "/>
                                        <Run Text="Drawing Mode"/>
                                    </TextBlock>
                                </GroupBox.Header>
                                <StackPanel Orientation="Horizontal" 
                                            Margin="10,8,10,8" 
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Mode:" 
                                               VerticalAlignment="Center" 
                                               Foreground="{StaticResource ForegroundBrush}" 
                                               Margin="0,0,8,0"/>
                                    <ComboBox x:Name="DrawingModeComboBox" 
                                              MinWidth="120"
                                              MaxWidth="180"
                                              VerticalAlignment="Center"
                                              SelectionChanged="DrawingModeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Free Pen"/>
                                        <ComboBoxItem Content="Rectangle" IsSelected="True"/>
                                        <ComboBoxItem Content="Polygon"/>
                                    </ComboBox>
                                </StackPanel>
                            </GroupBox>     

                            <!-- ✅ Auto Actions - Reorganized Layout -->
                            <GroupBox x:Name="AutoLabelGroupBox"
                                      Visibility="Visible"
                                      Foreground="{StaticResource AccentBrush}"
                                      Background="{StaticResource PanelBackground}"
                                      BorderBrush="{StaticResource PanelBorderBrush}"
                                      BorderThickness="2"
                                      VerticalAlignment="Top"
                                      MinWidth="320"
                                      MaxWidth="600">
                                <GroupBox.Header>
                                    <TextBlock FontWeight="Bold">
                                        <Run Text="🤖 "/>
                                        <Run Text="Auto Actions"/>
                                    </TextBlock>
                                </GroupBox.Header>
                                
                                <Grid Margin="10,4,10,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Size Filters -->
                                        <RowDefinition Height="Auto"/> <!-- Buttons Row -->
                                        <RowDefinition Height="Auto"/> <!-- Status -->
                                    </Grid.RowDefinitions>

                                    <!-- ⭐ Row 0: Size Filters (Collapsible) -->
                                    <Expander x:Name="SizeFiltersExpander"
                                              Header="📏 Size Filters" 
                                              IsExpanded="True" 
                                              Foreground="{StaticResource ForegroundBrush}"
                                              Margin="0,0,0,8"
                                              Expanded="SizeFiltersExpander_Expanded">
                                        <Grid Margin="8,8,8,4">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="12"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="55"/>
                                                <ColumnDefinition Width="*" MinWidth="140"/>
                                                <ColumnDefinition Width="55"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Min Width -->
                                            <TextBlock Text="Min W:" 
                                                       Grid.Row="0" Grid.Column="0"
                                                       VerticalAlignment="Center" 
                                                       Foreground="{StaticResource ForegroundBrush}"/>
                                            <Slider x:Name="MinWidthSlider" 
                                                    Grid.Row="0" Grid.Column="1"
                                                    Minimum="1" 
                                                    Maximum="500" 
                                                    Value="10" 
                                                    TickFrequency="10"
                                                    IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center"
                                                    Margin="4,0,4,0"
                                                    ValueChanged="MinWidthSlider_ValueChanged"/>
                                            <TextBlock x:Name="MinWidthValue" 
                                                       Grid.Row="0" Grid.Column="2"
                                                       Text="10" 
                                                       VerticalAlignment="Center" 
                                                       HorizontalAlignment="Right"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontWeight="Bold"
                                                       FontSize="13"/>

                                            <!-- Max Width -->
                                            <TextBlock Text="Max W:" 
                                                       Grid.Row="2" Grid.Column="0"
                                                       VerticalAlignment="Center" 
                                                       Foreground="{StaticResource ForegroundBrush}"/>
                                            <Slider x:Name="MaxWidthSlider" 
                                                    Grid.Row="2" Grid.Column="1"
                                                    Minimum="10" 
                                                    Maximum="2000" 
                                                    Value="1000" 
                                                    TickFrequency="50"
                                                    IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center"
                                                    Margin="4,0,4,0"
                                                    ValueChanged="MaxWidthSlider_ValueChanged"/>
                                            <TextBlock x:Name="MaxWidthValue" 
                                                       Grid.Row="2" Grid.Column="2"
                                                       Text="1000" 
                                                       VerticalAlignment="Center" 
                                                       HorizontalAlignment="Right"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontWeight="Bold"
                                                       FontSize="13"/>

                                            <!-- Min Height -->
                                            <TextBlock Text="Min H:" 
                                                       Grid.Row="4" Grid.Column="0"
                                                       VerticalAlignment="Center" 
                                                       Foreground="{StaticResource ForegroundBrush}"/>
                                            <Slider x:Name="MinHeightSlider" 
                                                    Grid.Row="4" Grid.Column="1"
                                                    Minimum="1" 
                                                    Maximum="500" 
                                                    Value="10" 
                                                    TickFrequency="10"
                                                    IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center"
                                                    Margin="4,0,4,0"
                                                    ValueChanged="MinHeightSlider_ValueChanged"/>
                                            <TextBlock x:Name="MinHeightValue" 
                                                       Grid.Row="4" Grid.Column="2"
                                                       Text="10" 
                                                       VerticalAlignment="Center" 
                                                       HorizontalAlignment="Right"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontWeight="Bold"
                                                       FontSize="13"/>

                                            <!-- Max Height -->
                                            <TextBlock Text="Max H:" 
                                                       Grid.Row="6" Grid.Column="0"
                                                       VerticalAlignment="Center" 
                                                       Foreground="{StaticResource ForegroundBrush}"/>
                                            <Slider x:Name="MaxHeightSlider" 
                                                    Grid.Row="6" Grid.Column="1"
                                                    Minimum="10" 
                                                    Maximum="2000" 
                                                    Value="1000" 
                                                    TickFrequency="50"
                                                    IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center"
                                                    Margin="4,0,4,0"
                                                    ValueChanged="MaxHeightSlider_ValueChanged"/>
                                            <TextBlock x:Name="MaxHeightValue" 
                                                       Grid.Row="6" Grid.Column="2"
                                                       Text="1000" 
                                                       VerticalAlignment="Center" 
                                                       HorizontalAlignment="Right"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontWeight="Bold"
                                                       FontSize="13"/>

                                            <!-- Reset Button -->
                                            <Button x:Name="ResetFilterButton"
                                                    Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3"
                                                    Content="🔄 Reset to Defaults"
                                                    Height="26"
                                                    FontSize="11"
                                                    Click="ResetFilterButton_Click"
                                                    HorizontalAlignment="Center"
                                                    MinWidth="140"/>
                                        </Grid>
                                    </Expander>

                                    <!-- ⭐ Row 1: Action Buttons (Always Visible) -->
                                    <Grid Grid.Row="1" Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Execute Button -->
                                        <Button x:Name="AutoLabelExecuteButton"
                                                Grid.Column="1"
                                                MinWidth="110"
                                                Height="34"
                                                IsEnabled="True"
                                                Click="AutoLabelExecuteButton_Click"
                                                Background="#4CAF50"
                                                Foreground="White"
                                                BorderThickness="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="▶ " FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Execute" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Apply Filter Button -->
                                        <Button x:Name="ClearPreviewButton"
                                                Grid.Column="3"
                                                MinWidth="110"
                                                Height="34"
                                                Click="ClearPreviewButton_Click"
                                                Background="#D32F2F"
                                                Foreground="White"
                                                BorderThickness="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✂️ " FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Apply Filter" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- ⭐ Row 2: Status Message -->
                                    <Border Grid.Row="2"
                                            Background="#E8F5E9"
                                            BorderBrush="#4CAF50"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,6"
                                            Margin="0,4,0,0"
                                            Visibility="Collapsed"
                                            x:Name="AutoLabelStatusBorder">
                                        <TextBlock x:Name="AutoLabelReadyTextBlock"
                                                   Text=""
                                                   TextWrapping="Wrap"
                                                   Foreground="#2E7D32"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </GroupBox>
                        
                        </StackPanel>
                    </StackPanel>

                    <!-- ✅ Main Content with dark theme borders -->
                    <Border x:Name="ImageAreaContainer" 
                            Grid.Row="1" 
                            BorderBrush="{StaticResource PanelBorderBrush}" 
                            BorderThickness="2" 
                            CornerRadius="8" 
                            Padding="0" 
                            Background="{StaticResource CardBackground}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="400" x:Name="RightColumn" />
                            </Grid.ColumnDefinitions>
                            
                            <!-- Image Viewer with Overlay -->
                            <Border Margin="0" 
                                    BorderBrush="{StaticResource SecondaryForeBrush}" 
                                    BorderThickness="1.5" 
                                    CornerRadius="8" 
                                    Background="#000000" 
                                    Grid.Column="0">
                                <Grid>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <Grid x:Name="ZoomContainer"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                            <Grid.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
                                                    <TranslateTransform x:Name="PanTransform" X="0" Y="0"/>
                                                </TransformGroup>
                                            </Grid.RenderTransform>
                                            <Image x:Name="LabelingImage"
                                                   Stretch="None"
                                                   RenderTransformOrigin="0.5,0.5"/>
                                            <Canvas x:Name="BoundingBoxCanvas"
                                                    Background="Transparent"
                                                    Focusable="True"
                                                    IsHitTestVisible="True"
                                                    Panel.ZIndex="1"
                                                    RenderTransformOrigin="0.5,0.5"
                                                    ContextMenuOpening="BoundingBoxCanvas_ContextMenuOpening">
                                                <Canvas.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem x:Name="CtxSaveProcessed" Header="Save Processed Preview" Click="SaveProcessedImage_ContextMenu_Click"/>
                                                        <MenuItem x:Name="CtxSaveCurrent"   Header="Save Current Image"     Click="SaveCurrentImage_ContextMenu_Click"/>
                                                        <Separator/>
                                                        <MenuItem x:Name="CtxRemoveSelected" Header="Remove Selected" Click="RemoveSelected_Click"/>
                                                        <MenuItem x:Name="CtxEditAnnotation"  Header="Edit Annotation"  Click="EditAnnotation_Click"/>
                                                        <MenuItem x:Name="CtxFinishDrawing" Header="Finish drawing" Click="FinishDrawing_Click" />
                                                    </ContextMenu>
                                                </Canvas.ContextMenu>
                                            </Canvas>

                                            <!-- Replace the existing FloatingProcessingMenu Border with this corrected block -->
                                            <Border x:Name="FloatingProcessingMenu"
        Background="#CCFFFFFF"
        BorderBrush="#888"
        BorderThickness="1"
        CornerRadius="6"
        Padding="6"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Margin="10"
        Panel.ZIndex="200"
        Visibility="Visible"
        Cursor="SizeAll"
        Focusable="True"
        RenderTransformOrigin="0,0"
        PreviewMouseLeftButtonDown="FloatingProcessingMenu_MouseLeftButtonDown"
        PreviewMouseMove="FloatingProcessingMenu_MouseMove"
        PreviewMouseLeftButtonUp="FloatingProcessingMenu_MouseLeftButtonUp">
                                                <Border.RenderTransform>
                                                    <TranslateTransform X="0" Y="0"/>
                                                </Border.RenderTransform>

                                                <StackPanel Orientation="Vertical" MinWidth="160">
                                                    <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                                        <Thumb x:Name="MenuDragThumb"
                   Width="12"
                   Height="12"
                   DockPanel.Dock="Left"
                   Cursor="SizeAll"
                   Margin="0,0,8,0"
                   Background="Transparent"
                   DragDelta="MenuDragThumb_DragDelta"/>
                                                        <ToggleButton x:Name="ProcessingMenuToggle"
                          Content="Processing ▾"
                          IsChecked="True"
                          Click="ToggleProcessingMenu_Click"
                          HorizontalAlignment="Stretch"/>
                                                    </DockPanel>

                                                    <StackPanel x:Name="ProcessingButtonsPanel" Orientation="Vertical" MinWidth="220">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                            <Button Content="Grayscale" Click="ProcessGrayscale_Click" Margin="0,0,6,0" Width="90"/>
                                                            <Button Content="Edges (Canny)" Click="ProcessEdges_Click" Margin="0,0,6,0" Width="110"/>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                            <Button Content="Contours" Click="ProcessContours_Click" Margin="0,0,6,0" Width="90"/>
                                                            <Button Content="Contour Rects" Click="ProcessContourRects_Click" Margin="0,0,6,0" Width="110"/>
                                                        </StackPanel>

                                                        <Separator Margin="0,6"/>

                                                        <StackPanel x:Name="GrayscaleOptionsPanel" Orientation="Vertical" Visibility="Collapsed" Margin="0,2">
                                                            <TextBlock Text="Grayscale Options" FontWeight="Bold" Margin="0,0,0,4"/>
                                                            <TextBlock Text="(No options)" FontStyle="Italic" Foreground="#666"/>
                                                        </StackPanel>

                                                        <StackPanel x:Name="EdgeOptionsPanel" Orientation="Vertical" Visibility="Collapsed" Margin="0,2">
                                                            <TextBlock Text="Edge (Canny) Options" FontWeight="Bold" Margin="0,4,0,6"/>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2">
                                                                <TextBlock Text="Canny T1:" Width="70" VerticalAlignment="Center"/>
                                                                <Slider x:Name="CannyThresh1Slider" Minimum="0" Maximum="500" Value="50" Width="100" TickFrequency="10"/>
                                                                <TextBlock x:Name="CannyThresh1Value" Width="36" Text="50" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>

                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2">
                                                                <TextBlock Text="Canny T2:" Width="70" VerticalAlignment="Center"/>
                                                                <Slider x:Name="CannyThresh2Slider" Minimum="0" Maximum="500" Value="150" Width="100" TickFrequency="10"/>
                                                                <TextBlock x:Name="CannyThresh2Value" Width="36" Text="150" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>

                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2">
                                                                <TextBlock Text="Blur:" Width="70" VerticalAlignment="Center"/>
                                                                <Slider x:Name="BlurKernelSlider" Minimum="1" Maximum="21" Value="5" Width="100" TickFrequency="2" IsSnapToTickEnabled="True"/>
                                                                <TextBlock x:Name="BlurKernelValue" Width="36" Text="5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <StackPanel x:Name="ContourOptionsPanel" Orientation="Vertical" Visibility="Collapsed" Margin="0,2">
                                                            <TextBlock Text="Contour Options" FontWeight="Bold" Margin="0,4,0,6"/>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2">
                                                                <TextBlock Text="Min Area:" Width="70" VerticalAlignment="Center"/>
                                                                <Slider x:Name="MinContourAreaSlider" Minimum="0" Maximum="5000" Value="50" Width="100" TickFrequency="10"/>
                                                                <TextBlock x:Name="MinContourAreaValue" Width="48" Text="50" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>

                                                            <CheckBox x:Name="DrawContourRectsCheckBox" Content="Draw contour rects" IsChecked="True" Margin="0,6"/>
                                                        </StackPanel>

                                                        <Separator Margin="0,6"/>

                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                                            <Button Content="Apply Now" x:Name="ApplyProcessingButton" MinWidth="80"/>
                                                            <Button Content="Reset" Click="ResetProcessing_Click" Margin="6,0,0,0" MinWidth="60"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Small preview badge shown when a processing mode is active -->
                                            <Border x:Name="ProcessingPreviewBadge"
                                                    Background="#AA000000"
                                                    CornerRadius="4"
                                                    Padding="6"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Margin="10,10,0,0"
                                                    Panel.ZIndex="210"
                                                    Visibility="Collapsed">
                                                <TextBlock x:Name="ProcessingPreviewText"
                                                           Foreground="White"
                                                           FontWeight="Bold"
                                                           Text="Preview"/>
                                            </Border>

                                            <!-- Collapsible Class Statistics Panel (replace only the existing ClassStatsPanel block) -->
                                            <Border x:Name="ClassStatsPanel"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="10"
                                                    Padding="8"
                                                    Background="#CCFFFFFF"
                                                    BorderBrush="#1976D2"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Panel.ZIndex="350"
                                                    Visibility="Collapsed">
                                                <StackPanel MinWidth="170">
                                                    <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                                        <TextBlock Text="Class Statistics"
                                                                   FontWeight="Bold"
                                                                   FontSize="13"
                                                                   Foreground="#1976D2"
                                                                   DockPanel.Dock="Left"
                                                                   VerticalAlignment="Center"/>
                                                        <ToggleButton x:Name="ClassStatsToggleButton"
                                                                      Width="28"
                                                                      Height="20"
                                                                      DockPanel.Dock="Right"
                                                                      VerticalAlignment="Center"
                                                                      HorizontalAlignment="Right"
                                                                      ToolTip="Collapse / Expand"
                                                                      Click="ClassStatsToggleButton_Click"
                                                                      Content="▾"
                                                                      Padding="0"
                                                                      Margin="6,0,0,0"/>
                                                    </DockPanel>

                                                    <StackPanel x:Name="ClassStatsBody" Visibility="Visible">
                                                        <ItemsControl x:Name="ClassStatsItems">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <DockPanel LastChildFill="False" Margin="0,2">
                                                                        <TextBlock Text="{Binding Label}" Foreground="#222" />
                                                                        <TextBlock Text="{Binding Count}" Foreground="#222" FontWeight="Bold" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                                                                    </DockPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <Separator Margin="0,6"/>

                                                        <TextBlock x:Name="ClassStatsTotal" Text="Total annotations: 0" Foreground="#1976D2" FontStyle="Italic" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Add this inside the existing `Grid x:Name="ZoomContainer"` (near other overlays like FloatingProcessingMenu) -->
                                            <TextBlock x:Name="SelectedClassBadge"
                                                       Text=""
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       Background="#66000000"
                                                       Padding="4,2"
                                                       Margin="8"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Top"
                                                       Panel.ZIndex="400"
                                                       Visibility="Collapsed"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Toggle button that sits at the right edge of the image area and collapses/expands the right panel -->
                            <ToggleButton x:Name="RightPanelToggleButton"
                                          Grid.Column="0"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Width="28"
                                          Height="64"
                                          Margin="0,0,0,0"
                                          Panel.ZIndex="500"
                                          ToolTip="Collapse / Expand Controls"
                                          Content="◀"
                                          Click="RightPanelToggleButton_Click"/>
                            <!--<ToggleButton x:Name="ClassStatsDockToggleButton"
                                          Grid.Column="0"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Width="80"
                                          Height="44"
                                          Margin="0,0,8,0"
                                          Panel.ZIndex="500"
                                          ToolTip="Collapse / Expand Controls"
                                          Click="RightPanelToggleButton_Click"
                                          Content="◀ Controls"/>-->

                            <!-- Annotation Controls -->
                            <!-- Find the AnnotationControlsPanel Border (around line 500-600) -->
                            <!-- Replace it with this version that has INDEPENDENT height: -->

                            <Border x:Name="AnnotationControlsPanel"
        Grid.Column="1"
        Background="#F5F5F5"
        CornerRadius="8"
        Padding="16"
        Margin="16,0,0,0"
        MinWidth="320"
        MaxWidth="420"
        VerticalAlignment="Top"
        MaxHeight="800">
                                <!-- ⭐ Changed from VerticalAlignment="Stretch" to VerticalAlignment="Top" -->
                                <!-- ⭐ Added MaxHeight="800" so it doesn't stretch to match image height -->

                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
                                    <Grid VerticalAlignment="Top">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <!-- Title -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- ListView -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- Remove button -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- Tip -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- Shortcuts -->
                                        </Grid.RowDefinitions>

                                        <!-- Title -->
                                        <TextBlock Grid.Row="0"
                       Text="Annotations" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Foreground="#222" 
                       Margin="0,0,0,10"/>

                                        <!-- ⭐ ListView with independent, flexible height -->
                                        <ListView x:Name="AnnotationListView"
                      Grid.Row="1"
                      MinHeight="100"
                      MaxHeight="400"
                      Margin="0,0,0,10"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      Background="#FFF"
                      Foreground="#222"
                      SelectionChanged="AnnotationListView_SelectionChanged"
                      MouseDoubleClick="AnnotationListView_MouseDoubleClick">
                                            <ListView.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Edit" Click="EditAnnotation_Click"/>
                                                    <MenuItem Header="Delete" Click="RemoveSelected_Click"/>
                                                </ContextMenu>
                                            </ListView.ContextMenu>
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="ImageName" Width="120" DisplayMemberBinding="{Binding ImageName}"/>
                                                    <GridViewColumn Header="Label" Width="80" DisplayMemberBinding="{Binding Label}"/>
                                                    <GridViewColumn Header="AnnotationType" Width="100" DisplayMemberBinding="{Binding AnnotationType}"/>
                                                    <GridViewColumn Header="Coordinates" Width="200" DisplayMemberBinding="{Binding Coordinates}"/>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>

                                        <!-- Remove Button -->
                                        <StackPanel Grid.Row="2"
                        Orientation="Horizontal" 
                        Margin="0,0,0,10">
                                            <Button Content="Remove Selected" 
                        Margin="0,0,10,0" 
                        MinWidth="100" 
                        Click="RemoveSelected_Click"/>
                                        </StackPanel>

                                        <!-- Tip -->
                                        <TextBlock Grid.Row="3"
                       Text="Tip: Drag to draw a box. Select a label before saving." 
                       FontStyle="Italic" 
                       Foreground="#1976D2"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>

                                        <!-- Shortcut Hints Panel -->
                                        <Border Grid.Row="4"
                    Background="#EEE" 
                    BorderBrush="#1976D2" 
                    BorderThickness="1" 
                    CornerRadius="6" 
                    Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="Keyboard Shortcuts:" 
                               FontWeight="Bold" 
                               FontSize="14" 
                               Foreground="#1976D2" 
                               Margin="0,0,0,6"/>
                                                <TextBlock Text="F: Next image" Foreground="#222"/>
                                                <TextBlock Text="S: Previous image" Foreground="#222"/>
                                                <TextBlock Text="A: Add box" Foreground="#222"/>
                                                <TextBlock Text="D: Remove selected" Foreground="#222"/>
                                                <TextBlock Text="E: Export YOLO" Foreground="#222"/>
                                                <TextBlock Text="Enter: Save annotations" Foreground="#222"/>
                                                <TextBlock Text="Ctrl+Z: Undo" Foreground="#222"/>
                                                <TextBlock Text="Ctrl+Y: Redo" Foreground="#222"/>
                                                <TextBlock Text="F: Toggle full screen" Foreground="#222"/>
                                                <TextBlock Text="(Polygon) Press Space Bar: Finish polygon" 
                               FontStyle="Italic" 
                               Foreground="#1976D2"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- No Project Panel (overlays main content) -->
                <Grid x:Name="NoProjectPanel" Visibility="Collapsed" IsHitTestVisible="False" Background="#FFF5F5F5">
                    <TextBlock Text="No Project"
                       Foreground="#222"
                       FontSize="48"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       Opacity="0.8"/>
                </Grid>

                <!-- Progress Overlay -->
                <Grid x:Name="ProgressOverlay"
                      Background="#80000000"
                      Visibility="Collapsed"
                      Panel.ZIndex="100">
                    <Border CornerRadius="8" Background="White" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock x:Name="ProgressMessage" Text="Please wait..." FontSize="20" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                            <ProgressBar IsIndeterminate="True" Height="20" Width="200"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Page>
