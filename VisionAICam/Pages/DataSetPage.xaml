<Page x:Class="VisionAICam.Pages.DataSetPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VisionAICam.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="ModelPage"
      Focusable="True"
      KeyDown="Page_KeyDown"
      Background="Transparent">

    <Page.Resources>
        <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#263238" Offset="0"/>
            <GradientStop Color="#37474F" Offset="0.5"/>
            <GradientStop Color="#263238" Offset="1"/>
        </LinearGradientBrush>
    </Page.Resources>

    <DockPanel LastChildFill="True" Background="{StaticResource PageBackgroundBrush}">
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="#FFF5F5F5" Foreground="#222">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="Background" Value="#FFF5F5F5"/>
                    <Setter Property="Foreground" Value="#222"/>
                    <Setter Property="Margin" Value="2"/>
                </Style>
            </Menu.Resources>
            <MenuItem Header="File">
                <MenuItem Header="New Project" Click="CreateProject_Click"/>
                <MenuItem Header="Open Project" Click="OpenProject_Click"/>
                <Separator/>
                <MenuItem Header="Save Project" Click="SaveProject_Click"/>
                <MenuItem Header="Export YOLO">
                    <MenuItem Header="Export YOLOv5"
                              Click="ExportYoloV5_Click"
                              ToolTip="YOLOv5: ⚙️ Stable and widely used for detection tasks. Great for legacy workflows."/>
                    <MenuItem Header="Export YOLOv5_OBB"
                                Click="ExportYoloV5_OBB_Click"
                                ToolTip="YOLOv5_OBB: 📐 Oriented Bounding Boxes for rotated objects. Ideal for aerial imagery and text detection."/>
                    <MenuItem Header="Export YOLOv8"
                              Click="ExportYoloV8_Click"
                              ToolTip="YOLOv8: 🚀 Latest version with better speed, accuracy, and support for new features."/>
                    <MenuItem Header="Export YOLOv8_OBB"
                              Click="ExportYoloV8_OBB_Click"
                                ToolTip="YOLOv8_OBB: 📐 Oriented Bounding Boxes with the advancements of YOLOv8."/>
                    <MenuItem Header="Export YOLOv8_SEG"
                              Click="ExportYoloV8_SEG_Click"
                              ToolTip="YOLOv8_SEG: 🖌️ Segmentation support for pixel-level object annotation. Ideal for advanced tasks like instance segmentation."/>
                </MenuItem>
                <MenuItem Header="Close Project" Click="CloseProject_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="Undo" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
                <MenuItem Header="Redo" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
                <Separator/>
                <MenuItem Header="Remove Selected" Click="RemoveSelected_Click"/>
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem Header="Zoom In" InputGestureText="Ctrl++" Click="ZoomIn_Click"/>
                <MenuItem Header="Zoom Out" InputGestureText="Ctrl+-" Click="ZoomOut_Click"/>
                <MenuItem Header="Full Screen" InputGestureText="F11" Click="FullScreenToggleButton_Click"/>
                <MenuItem Header="Processing Panel" x:Name="ToggleProcessingPanelMenu" IsCheckable="True" Click="ToggleProcessingPanelMenu_Click" InputGestureText="Ctrl+P"/>
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="View Help" Click="ViewHelp_Click"/>
                <MenuItem Header="About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Status Bar at the very bottom -->
        <StatusBar DockPanel.Dock="Bottom" FontSize="13" Background="#FFF5F5F5" Foreground="#222">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Ready" />
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content with scrollbars -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="MainLayoutGrid" Margin="30" Background="#FFF">
                <!-- Main Content Panel (hidden by default) -->
                <Grid x:Name="MainContentPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Title and Navigation (vertical layout) -->
                    <StackPanel x:Name="TitlePanel" Grid.Row="0" Orientation="Vertical" VerticalAlignment="Top" Margin="0,0,0,8">
                        <TextBlock Text="Data Preparation"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#222"
                                   Margin="0,0,0,6"/>
                        <GroupBox Header="Image Navigation" Margin="0,0,0,4" Foreground="#222" Background="#FFF5F5F5" BorderBrush="#FFD54F">
                            <StackPanel Orientation="Horizontal" Margin="10,0,0,0" Background="#FFF5F5F5">
                                <Button Content="Load Folder" MinWidth="100" Click="LoadFolder_Click" Margin="0,0,10,0"/>
                                <Button Content="Previous" MinWidth="80" Click="PrevImage_Click" Margin="0,0,10,0"/>
                                <Button Content="Next" MinWidth="80" Click="NextImage_Click"/>
                                <TextBlock x:Name="ImageProgressText" Text="No images loaded" FontSize="16" Foreground="#222" VerticalAlignment="Center" Margin="20,0,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <!-- Controls Row: Class Management (left), Drawing Mode (right) -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <GroupBox Header="Class Management"
                                      Margin="0,0,4,0"
                                      Foreground="#222"
                                      Background="#FFF5F5F5"
                                      BorderBrush="#1976D2"
                                      HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Margin="5,0,0,0" Background="#FFF5F5F5">
                                    <TextBlock Text="Label:" VerticalAlignment="Center" Foreground="#222" Margin="0,0,5,0"/>
                                    <ComboBox x:Name="LabelComboBox" MinWidth="100" Margin="0,0,5,0"/>
                                    <TextBox x:Name="NewClassTextBox" MinWidth="80" Margin="0,0,5,0" VerticalAlignment="Center" ToolTip="Add new class"/>
                                    <Button Content="Add Class" MinWidth="70" Click="AddClassButton_Click"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Drawing Mode"
                                      Margin="0,0,0,0"
                                      Foreground="#222"
                                      Background="#FFF5F5F5"
                                      BorderBrush="#1976D2"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0" Background="#FFF5F5F5">
                                    <TextBlock Text="Drawing Mode:" VerticalAlignment="Center" Foreground="#222" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="DrawingModeComboBox" MinWidth="120" SelectionChanged="DrawingModeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Free Pen"/>
                                        <ComboBoxItem Content="Rectangle" IsSelected="True"/>
                                        <ComboBoxItem Content="Polygon"/>
                                    </ComboBox>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </StackPanel>

                    <!-- Main Content -->
                    <Border x:Name="ImageAreaContainer" Grid.Row="1" BorderBrush="#90CAF9" BorderThickness="2" CornerRadius="8" Padding="0" Background="#FFF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="400" />
                            </Grid.ColumnDefinitions>
                            <!-- Image Viewer with Overlay -->
                            <Border Margin="0" BorderBrush="#B0BEC5" BorderThickness="1.5" CornerRadius="8" Background="#FFF" Grid.Column="0">
                                <Grid>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <Grid x:Name="ZoomContainer"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                            <Grid.RenderTransform>
                                                <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
                                            </Grid.RenderTransform>
                                            <Image x:Name="LabelingImage"
                                                   Stretch="None"
                                                   RenderTransformOrigin="0.5,0.5"/>
                                            <Canvas x:Name="BoundingBoxCanvas"
                                                    Background="Transparent"
                                                    Focusable="True"
                                                    IsHitTestVisible="True"
                                                    Panel.ZIndex="1"
                                                    RenderTransformOrigin="0.5,0.5"
                                                    ContextMenuOpening="BoundingBoxCanvas_ContextMenuOpening">
                                                <Canvas.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem x:Name="CtxSaveProcessed" Header="Save Processed Preview" Click="SaveProcessedImage_ContextMenu_Click"/>
                                                        <MenuItem x:Name="CtxSaveCurrent"   Header="Save Current Image"     Click="SaveCurrentImage_ContextMenu_Click"/>
                                                        <Separator/>
                                                        <MenuItem x:Name="CtxRemoveSelected" Header="Remove Selected" Click="RemoveSelected_Click"/>
                                                        <MenuItem x:Name="CtxEditAnnotation"  Header="Edit Annotation"  Click="EditAnnotation_Click"/>
                                                        <MenuItem x:Name="CtxFinishDrawing" Header="Finish drawing" Click="FinishDrawing_Click" />
                                                    </ContextMenu>
                                                </Canvas.ContextMenu>
                                            </Canvas>

                                           <!-- Replace the existing FloatingProcessingMenu Border with this corrected block -->
                                            <Border x:Name="FloatingProcessingMenu"
        Background="#CCFFFFFF"
        BorderBrush="#888"
        BorderThickness="1"
        CornerRadius="6"
        Padding="6"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Margin="10"
        Panel.ZIndex="200"
        Visibility="Visible"
        Cursor="SizeAll"
        Focusable="True"
        RenderTransformOrigin="0,0"
        PreviewMouseLeftButtonDown="FloatingProcessingMenu_MouseLeftButtonDown"
        PreviewMouseMove="FloatingProcessingMenu_MouseMove"
        PreviewMouseLeftButtonUp="FloatingProcessingMenu_MouseLeftButtonUp">
    <Border.RenderTransform>
        <TranslateTransform X="0" Y="0"/>
    </Border.RenderTransform>

    <StackPanel Orientation="Vertical" MinWidth="160">
        <DockPanel LastChildFill="True" Margin="0,0,0,6">
            <Thumb x:Name="MenuDragThumb"
                   Width="12"
                   Height="12"
                   DockPanel.Dock="Left"
                   Cursor="SizeAll"
                   Margin="0,0,8,0"
                   Background="Transparent"
                   DragDelta="MenuDragThumb_DragDelta"/>
            <ToggleButton x:Name="ProcessingMenuToggle"
                          Content="Processing ▾"
                          IsChecked="True"
                          Click="ToggleProcessingMenu_Click"
                          HorizontalAlignment="Stretch"/>
        </DockPanel>

        <StackPanel x:Name="ProcessingButtonsPanel" Orientation="Vertical" MinWidth="220">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="Grayscale" Click="ProcessGrayscale_Click" Margin="0,0,6,0" Width="90"/>
                <Button Content="Edges (Canny)" Click="ProcessEdges_Click" Margin="0,0,6,0" Width="110"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="Contours" Click="ProcessContours_Click" Margin="0,0,6,0" Width="90"/>
                <Button Content="Contour Rects" Click="ProcessContourRects_Click" Margin="0,0,0,6" Width="110"/>
            </StackPanel>

            <Separator Margin="0,6"/>

            <StackPanel x:Name="GrayscaleOptionsPanel" Orientation="Vertical" Visibility="Collapsed" Margin="0,2">
                <TextBlock Text="Grayscale Options" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="(No options)" FontStyle="Italic" Foreground="#666"/>
            </StackPanel>

            <StackPanel x:Name="EdgeOptionsPanel" Orientation="Vertical" Visibility="Collapsed" Margin="0,2">
                <TextBlock Text="Edge (Canny) Options" FontWeight="Bold" Margin="0,4,0,6"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2">
                    <TextBlock Text="Canny T1:" Width="70" VerticalAlignment="Center"/>
                    <Slider x:Name="CannyThresh1Slider" Minimum="0" Maximum="500" Value="50" Width="100" TickFrequency="10"/>
                    <TextBlock x:Name="CannyThresh1Value" Width="36" Text="50" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2">
                    <TextBlock Text="Canny T2:" Width="70" VerticalAlignment="Center"/>
                    <Slider x:Name="CannyThresh2Slider" Minimum="0" Maximum="500" Value="150" Width="100" TickFrequency="10"/>
                    <TextBlock x:Name="CannyThresh2Value" Width="36" Text="150" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2">
                    <TextBlock Text="Blur:" Width="70" VerticalAlignment="Center"/>
                    <Slider x:Name="BlurKernelSlider" Minimum="1" Maximum="21" Value="5" Width="100" TickFrequency="2" IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="BlurKernelValue" Width="36" Text="5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="ContourOptionsPanel" Orientation="Vertical" Visibility="Collapsed" Margin="0,2">
                <TextBlock Text="Contour Options" FontWeight="Bold" Margin="0,4,0,6"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2">
                    <TextBlock Text="Min Area:" Width="70" VerticalAlignment="Center"/>
                    <Slider x:Name="MinContourAreaSlider" Minimum="0" Maximum="5000" Value="50" Width="100" TickFrequency="10"/>
                    <TextBlock x:Name="MinContourAreaValue" Width="48" Text="50" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <CheckBox x:Name="DrawContourRectsCheckBox" Content="Draw contour rects" IsChecked="True" Margin="0,6"/>
            </StackPanel>

            <Separator Margin="0,6"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Apply Now" x:Name="ApplyProcessingButton" MinWidth="80"/>
                <Button Content="Reset" Click="ResetProcessing_Click" Margin="6,0,0,0" MinWidth="60"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Border>

                                            <!-- Small preview badge shown when a processing mode is active -->
                                            <Border x:Name="ProcessingPreviewBadge"
                                                    Background="#AA000000"
                                                    CornerRadius="4"
                                                    Padding="6"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Margin="10,10,0,0"
                                                    Panel.ZIndex="210"
                                                    Visibility="Collapsed">
                                                <TextBlock x:Name="ProcessingPreviewText"
                                                           Foreground="White"
                                                           FontWeight="Bold"
                                                           Text="Preview"/>
                                            </Border>

                                            <!-- Collapsible Class Statistics Panel (replace only the existing ClassStatsPanel block) -->
                                            <Border x:Name="ClassStatsPanel"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="10"
                                                    Padding="8"
                                                    Background="#CCFFFFFF"
                                                    BorderBrush="#1976D2"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Panel.ZIndex="350"
                                                    Visibility="Collapsed">
                                                <StackPanel MinWidth="170">
                                                    <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                                        <TextBlock Text="Class Statistics"
                                                                   FontWeight="Bold"
                                                                   FontSize="13"
                                                                   Foreground="#1976D2"
                                                                   DockPanel.Dock="Left"
                                                                   VerticalAlignment="Center"/>
                                                        <ToggleButton x:Name="ClassStatsToggleButton"
                                                                      Width="28"
                                                                      Height="20"
                                                                      DockPanel.Dock="Right"
                                                                      VerticalAlignment="Center"
                                                                      HorizontalAlignment="Right"
                                                                      ToolTip="Collapse / Expand"
                                                                      Click="ClassStatsToggleButton_Click"
                                                                      Content="▾"
                                                                      Padding="0"
                                                                      Margin="6,0,0,0"/>
                                                    </DockPanel>

                                                    <StackPanel x:Name="ClassStatsBody" Visibility="Visible">
                                                        <ItemsControl x:Name="ClassStatsItems">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <DockPanel LastChildFill="False" Margin="0,2">
                                                                        <TextBlock Text="{Binding Label}" Foreground="#222" />
                                                                        <TextBlock Text="{Binding Count}" Foreground="#222" FontWeight="Bold" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                                                                    </DockPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <Separator Margin="0,6"/>

                                                        <TextBlock x:Name="ClassStatsTotal" Text="Total annotations: 0" Foreground="#1976D2" FontStyle="Italic" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                            <!-- Annotation Controls -->
                            <Border Grid.Column="1"
                                    Background="#F5F5F5"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="16,0,0,0"
                                    MinWidth="320"
                                    MaxWidth="420">
                                <Grid VerticalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Annotations" FontSize="20" FontWeight="Bold" Foreground="#222" Margin="0,0,0,10" Grid.Row="0"/>
                                    <ListView x:Name="AnnotationListView"
                                              MinHeight="120"
                                              Margin="0,0,0,10"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              Background="#FFF"
                                              Foreground="#222"
                                              Grid.Row="1">         
                                        <ListView.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Edit" Click="EditAnnotation_Click"/>
                                            </ContextMenu>
                                        </ListView.ContextMenu>
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="ImageName" Width="120" DisplayMemberBinding="{Binding ImageName}"/>
                                                <GridViewColumn Header="Label" Width="80" DisplayMemberBinding="{Binding Label}"/>
                                                <GridViewColumn Header="AnnotationType" Width="100" DisplayMemberBinding="{Binding AnnotationType}"/>
                                                <GridViewColumn Header="Coordinates" Width="200" DisplayMemberBinding="{Binding Coordinates}"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Grid.Row="2">
                                        <Button Content="Remove Selected" Margin="0,0,10,0" MinWidth="100" Click="RemoveSelected_Click"/>
                                    </StackPanel>
                                    <TextBlock Text="Tip: Drag to draw a box. Select a label before saving." FontStyle="Italic" Foreground="#1976D2" Grid.Row="3"/>
                                    <!-- Shortcut Hints Panel -->
                                    <Border Background="#EEE" BorderBrush="#1976D2" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0" Grid.Row="4">
                                        <StackPanel>
                                            <TextBlock Text="Keyboard Shortcuts:" FontWeight="Bold" FontSize="14" Foreground="#1976D2" Margin="0,0,0,6"/>
                                            <TextBlock Text="F: Next image" Foreground="#222"/>
                                            <TextBlock Text="S: Previous image" Foreground="#222"/>
                                            <TextBlock Text="A: Add box" Foreground="#222"/>
                                            <TextBlock Text="D: Remove selected" Foreground="#222"/>
                                            <TextBlock Text="E: Export YOLO" Foreground="#222"/>
                                            <TextBlock Text="Enter: Save annotations" Foreground="#222"/>
                                            <TextBlock Text="Ctrl+Z: Undo" Foreground="#222"/>
                                            <TextBlock Text="Ctrl+Y: Redo" Foreground="#222"/>
                                            <TextBlock Text="F: Toggle full screen" Foreground="#222"/>
                                            <TextBlock Text="(Polygon) Press Space Bar: Finish polygon" FontStyle="Italic" Foreground="#1976D2"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- No Project Panel (overlays main content) -->
                <Grid x:Name="NoProjectPanel" Visibility="Visible" IsHitTestVisible="False" Background="#FFF5F5F5">
                    <TextBlock Text="No Project"
                       Foreground="#222"
                       FontSize="48"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       Opacity="0.8"/>
                </Grid>

                <!-- Progress Overlay -->
                <Grid x:Name="ProgressOverlay"
                      Background="#80000000"
                      Visibility="Collapsed"
                      Panel.ZIndex="100">
                    <Border CornerRadius="8" Background="White" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock x:Name="ProgressMessage" Text="Please wait..." FontSize="20" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                            <ProgressBar IsIndeterminate="True" Height="20" Width="200"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Page>
