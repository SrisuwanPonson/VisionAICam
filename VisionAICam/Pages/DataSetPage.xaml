<Page x:Class="VisionAICam.Pages.DataSetPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VisionAICam.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="ModelPage"
      Focusable="True"
      KeyDown="Page_KeyDown"
      Background="Transparent">

    <Page.Resources>
        <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#263238" Offset="0"/>
            <GradientStop Color="#37474F" Offset="0.5"/>
            <GradientStop Color="#263238" Offset="1"/>
        </LinearGradientBrush>
    </Page.Resources>

    <DockPanel LastChildFill="True" Background="{StaticResource PageBackgroundBrush}">
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="#FFF5F5F5" Foreground="#222">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="Background" Value="#FFF5F5F5"/>
                    <Setter Property="Foreground" Value="#222"/>
                    <Setter Property="Margin" Value="2"/>
                </Style>
            </Menu.Resources>
            <MenuItem Header="File">
                <MenuItem Header="New Project" Click="CreateProject_Click"/>
                <MenuItem Header="Open Project" Click="OpenProject_Click"/>
                <Separator/>
                <MenuItem Header="Save Project" Click="SaveProject_Click"/>
                <MenuItem Header="Export YOLO">
                    <MenuItem Header="Export YOLOv5"
                              Click="ExportYoloV5_Click"
                              ToolTip="YOLOv5: ⚙️ Stable and widely used for detection tasks. Great for legacy workflows."/>
                    <MenuItem Header="Export YOLOv8"
                              Click="ExportYoloV8_Click"
                              ToolTip="YOLOv8: 🚀 Latest version with better speed, accuracy, and support for new features."/>
                </MenuItem>
                <MenuItem Header="Close Project" Click="CloseProject_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="Undo" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
                <MenuItem Header="Redo" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
                <Separator/>
                <MenuItem Header="Remove Selected" Click="RemoveSelected_Click"/>
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem Header="Zoom In" InputGestureText="Ctrl++" Click="ZoomIn_Click"/>
                <MenuItem Header="Zoom Out" InputGestureText="Ctrl+-" Click="ZoomOut_Click"/>
                <MenuItem Header="Full Screen" InputGestureText="F11" Click="FullScreenToggleButton_Click"/>
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="View Help" Click="ViewHelp_Click"/>
                <MenuItem Header="About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Status Bar at the very bottom -->
        <StatusBar DockPanel.Dock="Bottom" FontSize="13" Background="#FFF5F5F5" Foreground="#222">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Ready" />
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content fills the remaining space -->
        <Grid x:Name="MainLayoutGrid" Margin="30" Background="#FFF">
            <!-- Main Content Panel (hidden by default) -->
            <Grid x:Name="MainContentPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title and Navigation -->
                <StackPanel x:Name="TitlePanel" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="Data Preparation"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#222"
                               Margin="0,0,20,0"/>
                    <GroupBox Header="Image Navigation" Margin="0,0,0,10" Foreground="#222" Background="#FFF5F5F5" BorderBrush="#FFD54F">
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0" Background="#FFF5F5F5">
                            <Button Content="Load Folder" Width="120" Click="LoadFolder_Click" Margin="0,0,10,0"/>
                            <Button Content="Previous" Width="100" Click="PrevImage_Click" Margin="0,0,10,0"/>
                            <Button Content="Next" Width="100" Click="NextImage_Click"/>
                            <TextBlock x:Name="ImageProgressText" Text="No images loaded" FontSize="16" Foreground="#222" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>

                <!-- Main Content -->
                <Border x:Name="ImageAreaContainer" Grid.Row="1" BorderBrush="#90CAF9" BorderThickness="2" CornerRadius="8" Padding="0" Background="#FFF">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>
                        <!-- Image Viewer with Overlay -->
                        <Border Margin="0" BorderBrush="#B0BEC5" BorderThickness="1.5" CornerRadius="8" Background="#FFF" Grid.Column="0">
                            <Grid>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <Grid x:Name="ZoomContainer"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Grid.RenderTransform>
                                            <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
                                        </Grid.RenderTransform>
                                        <Image x:Name="LabelingImage"
                                               Stretch="None"
                                               RenderTransformOrigin="0.5,0.5"/>
                                        <Canvas x:Name="BoundingBoxCanvas"
                                                Background="Transparent"
                                                Focusable="True"
                                                IsHitTestVisible="True"
                                                Panel.ZIndex="1"
                                                RenderTransformOrigin="0.5,0.5"/>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <!-- Annotation Controls -->
                        <Border Grid.Column="1" Background="#F5F5F5" CornerRadius="8" Padding="16" Margin="16,0,0,0">
                            <StackPanel x:Name="AnnotationPanel" VerticalAlignment="Stretch">
                                <!-- Drawing Mode Selector -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Drawing Mode:" VerticalAlignment="Center" Foreground="#222" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="DrawingModeComboBox" Width="140" SelectionChanged="DrawingModeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Free Pen"/>
                                        <ComboBoxItem Content="Rectangle" IsSelected="True"/>
                                        <ComboBoxItem Content="Polygon"/>
                                    </ComboBox>
                                </StackPanel>

                                <TextBlock Text="Annotations" FontSize="20" FontWeight="Bold" Foreground="#222" Margin="0,0,0,10"/>
                                <ListView x:Name="AnnotationListView" Height="200" Margin="0,0,0,10"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          Background="#FFF"
                                          Foreground="#222">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="ImageName" Width="120" DisplayMemberBinding="{Binding ImageName}"/>
                                            <GridViewColumn Header="Label" Width="80" DisplayMemberBinding="{Binding Label}"/>
                                            <GridViewColumn Header="AnnotationType" Width="100" DisplayMemberBinding="{Binding AnnotationType}"/>
                                            <GridViewColumn Header="Coordinates" Width="200" DisplayMemberBinding="{Binding Coordinates}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Remove Selected" Margin="0,0,10,0" Width="120" Click="RemoveSelected_Click"/>
                                </StackPanel>
                                <!-- Label/Class Management -->
                                <Grid Margin="0,0,0,10" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Label:" VerticalAlignment="Center" Foreground="#222" Grid.Column="0" Margin="0,0,5,0"/>
                                    <ComboBox x:Name="LabelComboBox" MinWidth="120" Grid.Column="1" Margin="0,0,5,0"/>
                                    <Rectangle x:Name="LabelColorRect" Width="18" Height="18" Stroke="Black" StrokeThickness="1" Grid.Column="2" Margin="0,0,5,0"/>
                                    <TextBox x:Name="NewClassTextBox" MinWidth="90" Grid.Column="3" Margin="0,0,5,0" VerticalAlignment="Center" ToolTip="Add new class"/>
                                    <Button Content="Add Class" MinWidth="80" Grid.Column="4" Click="AddClassButton_Click"/>
                                </Grid>
                                <TextBlock Text="Tip: Drag to draw a box. Select a label before saving." FontStyle="Italic" Foreground="#1976D2"/>
                                <!-- Shortcut Hints Panel -->
                                <Border Background="#EEE" BorderBrush="#1976D2" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Keyboard Shortcuts:" FontWeight="Bold" FontSize="14" Foreground="#1976D2" Margin="0,0,0,6"/>
                                        <TextBlock Text="F: Next image" Foreground="#222"/>
                                        <TextBlock Text="S: Previous image" Foreground="#222"/>
                                        <TextBlock Text="A: Add box" Foreground="#222"/>
                                        <TextBlock Text="D: Remove selected" Foreground="#222"/>
                                        <TextBlock Text="E: Export YOLO" Foreground="#222"/>
                                        <TextBlock Text="Enter: Save annotations" Foreground="#222"/>
                                        <TextBlock Text="Ctrl+Z: Undo" Foreground="#222"/>
                                        <TextBlock Text="Ctrl+Y: Redo" Foreground="#222"/>
                                        <TextBlock Text="F: Toggle full screen" Foreground="#222"/>
                                        <TextBlock Text="(Polygon) Double-click or right-click: Finish polygon" FontStyle="Italic" Foreground="#1976D2"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- No Project Panel (overlays main content) -->
            <Grid x:Name="NoProjectPanel" Visibility="Visible" IsHitTestVisible="False" Background="#FFF5F5F5">
                <TextBlock Text="No Project"
               Foreground="#222"
               FontSize="48"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               TextAlignment="Center"
               Opacity="0.8"/>
            </Grid>

            <!-- Progress Overlay -->
            <Grid x:Name="ProgressOverlay"
                  Background="#80000000"
                  Visibility="Collapsed"
                  Panel.ZIndex="100">
                <Border CornerRadius="8" Background="White" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="ProgressMessage" Text="Please wait..." FontSize="20" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                        <ProgressBar IsIndeterminate="True" Height="20" Width="200"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Page>
