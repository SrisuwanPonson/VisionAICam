<Page x:Class="VisionAICam.Pages.DiagnosticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="DiagnosticsPage">

    <Grid>
        <TabControl Margin="10">

            <!-- 🖥️ System Info Tab -->
            <TabItem Header="System Info">
                <GroupBox Header="Step 1: System Information" Margin="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="OS:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="OsVersionText"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text=".NET:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DotNetVersionText"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Memory:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MemoryText"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="CPU:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CpuText"/>
                    </Grid>
                </GroupBox>
            </TabItem>

            <!-- 📷 Camera Diagnostics Tab -->
            <TabItem Header="Camera">
                <GroupBox Header="Step 2: Camera Diagnostics" Margin="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" x:Name="CameraListText"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <Button x:Name="RefreshCamerasButton"
                                    Content="Refresh Cameras"
                                    Width="150"
                                    HorizontalAlignment="Left"
                                    Click="RefreshCamerasButton_Click"/>

                            <Button x:Name="LiveButton"
                                    Content="Live"
                                    Width="100"
                                    HorizontalAlignment="Left"
                                    Click="LiveButton_Click"/>

                            <Button x:Name="StopButton"
                                    Content="Stop"
                                    Width="100"
                                    HorizontalAlignment="Left"
                                    Click="StopButton_Click"/>

                            <Button x:Name="CaptureButton"
                                    Content="Capture"
                                    Width="100"
                                    HorizontalAlignment="Left"
                                    Click="CaptureButton_Click"/>
                            
                        </StackPanel>

                        <TextBlock Grid.Row="2" x:Name="CameraStatusText" Margin="0,8,0,0"/>

                        <Border Grid.Row="3" Margin="0,8,0,0" BorderBrush="LightGray" BorderThickness="1" Padding="4">
                            <Image x:Name="CameraPreviewImage"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch" />
                        </Border>
                    </Grid>
                </GroupBox>
            </TabItem>

            <!-- 🧠 Model Diagnostics Tab -->
            <TabItem Header="Model">
                <GroupBox Header="Step 3: Model Diagnostics" Margin="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Model info -->
                            <RowDefinition Height="Auto"/> <!-- Selected model path -->
                            <RowDefinition Height="Auto"/> <!-- Buttons -->
                            <RowDefinition Height="*"/>    <!-- Image + canvas -->
                        </Grid.RowDefinitions>

                        <!-- Model info (kept for LoadModelInfo) -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Text="Model:" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ModelInfoText" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Selected model path -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Text="Selected model:" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock x:Name="ModelPathText" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Width="420"/>
                        </StackPanel>

                        <!-- Model buttons -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Select Model..." Width="120" Click="SelectModelButton_Click" />
                            <Button Content="Save Model" Width="100" Margin="8,0,0,0" Click="SaveModelButton_Click" />
                            <Button Content="Load Image..." Width="120" Margin="16,0,0,0" Click="LoadImageButton_Click" />
                            <Button Content="Run Inference" Width="120" Margin="8,0,0,0" Click="RunInferenceButton_Click" />
                            <Button Content="Test Model" Width="100" Margin="8,0,0,0" Click="TestModelButton_Click" />
                        </StackPanel>

                        <!-- Image + overlay canvas -->
                        <Border Grid.Row="3" BorderBrush="LightGray" BorderThickness="1" Padding="4">
                            <Grid>
                                <Viewbox Stretch="Uniform">
                                    <Grid>
                                        <Image x:Name="ModelTestImage" Stretch="Uniform" />
                                        <Canvas x:Name="ModelBoundingCanvas" IsHitTestVisible="False" Background="Transparent" />
                                    </Grid>
                                </Viewbox>
                            </Grid>
                        </Border>
                    </Grid>
                </GroupBox>
            </TabItem>

            <!-- 📊 Performance Metrics Tab -->
            <TabItem Header="Performance">
                <GroupBox Header="Step 4: Performance Metrics" Margin="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="FPS:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="FpsText"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Inference Time:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InferenceTimeText"/>
                    </Grid>
                </GroupBox>
            </TabItem>

            <!-- 📜 Logs Tab -->
            <TabItem Header="Logs">
                <GroupBox Header="Step 5: Logs" Margin="10">
                    <TextBox x:Name="LogTextBox"
                             Height="120"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </GroupBox>
            </TabItem>

        </TabControl>
    </Grid>
</Page>