<Page x:Class="VisionAICam.Pages.DiagnosticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="DiagnosticsPage">

    <Page.Resources>
        <!-- Light background gradient -->
        <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5F5F5" Offset="0"/>
            <GradientStop Color="#E0E0E0" Offset="1"/>
        </LinearGradientBrush>

        <!-- Text styling -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- GroupBox styling -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Button styling -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </Page.Resources>

    <Page.Background>
        <StaticResource ResourceKey="PageBackgroundBrush"/>
    </Page.Background>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Title -->
        <TextBlock Text="Diagnostics"
                   FontSize="30"
                   FontWeight="Bold"
                   Margin="0,0,0,20"
                   Grid.Row="0"/>

        <!-- Diagnostic Sections -->
        <StackPanel Grid.Row="1" Orientation="Vertical">

            <!-- Step 1: System Info -->
            <GroupBox Header="Step 1: System Information">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="OS:" FontWeight="Bold"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="OsVersionText" Text="Windows 11"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text=".NET:" FontWeight="Bold"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DotNetVersionText" Text="8.0"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Memory:" FontWeight="Bold"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MemoryText" Text="16 GB"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="CPU:" FontWeight="Bold"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CpuText" Text="Intel Core i7"/>
                </Grid>
            </GroupBox>

            <!-- Step 2: Camera Diagnostics -->
            <GroupBox Header="Step 2: Camera Diagnostics">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="CameraListText" Text="Detected Cameras: HD Pro Webcam C920"/>
                    <Button Grid.Row="1" Content="Refresh Cameras" Width="150" HorizontalAlignment="Left" Click="RefreshCamerasButton_Click"/>
                </Grid>
            </GroupBox>

            <!-- Step 3: Model Diagnostics -->
            <GroupBox Header="Step 3: Model Diagnostics">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="ModelInfoText" Text="Model: YOLOv5s (Ultralytics)"/>
                    <Button Grid.Row="1" Content="Test Model Inference" Width="180" HorizontalAlignment="Left" Click="TestModelButton_Click"/>
                </Grid>
            </GroupBox>

            <!-- Step 4: Performance Metrics -->
            <GroupBox Header="Step 4: Performance Metrics">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="FPS:" FontWeight="Bold"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="FpsText" Text="30.2"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Inference Time:" FontWeight="Bold"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InferenceTimeText" Text="42 ms"/>
                </Grid>
            </GroupBox>

            <!-- Step 5: Logs -->
            <GroupBox Header="Step 5: Logs">
                <TextBox x:Name="LogTextBox"
                         Height="80"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </GroupBox>
        </StackPanel>
    </Grid>
</Page>