<Page x:Class="VisionAICam.Pages.DiagnosticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="DiagnosticsPage">

    <Grid>
        <TabControl Margin="10">

            <!-- 🖥️ System Info Tab -->
            <TabItem Header="System Info">
                <GroupBox Header="Step 1: System Information" Margin="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="OS:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="OsVersionText"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text=".NET:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DotNetVersionText"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Memory:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MemoryText"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="CPU:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CpuText"/>
                    </Grid>
                </GroupBox>
            </TabItem>

            <!-- 📷 Camera Diagnostics Tab -->
            <TabItem Header="Camera">
                <GroupBox Header="Step 2: Camera Diagnostics" Margin="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" x:Name="CameraListText"/>
                        <Button Grid.Row="1" Content="Refresh Cameras" Width="150" HorizontalAlignment="Left" Click="RefreshCamerasButton_Click"/>
                    </Grid>
                </GroupBox>
            </TabItem>

            <!-- 🧠 Model Diagnostics Tab -->
            <TabItem Header="Model">
                <GroupBox Header="Step 3: Model Diagnostics" Margin="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" x:Name="ModelInfoText"/>
                        <Button Grid.Row="1" Content="Test Model Inference" Width="180" HorizontalAlignment="Left" Click="TestModelButton_Click"/>
                    </Grid>
                </GroupBox>
            </TabItem>

            <!-- 📊 Performance Metrics Tab -->
            <TabItem Header="Performance">
                <GroupBox Header="Step 4: Performance Metrics" Margin="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="FPS:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="FpsText"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Inference Time:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InferenceTimeText"/>
                    </Grid>
                </GroupBox>
            </TabItem>

            <!-- 📜 Logs Tab -->
            <TabItem Header="Logs">
                <GroupBox Header="Step 5: Logs" Margin="10">
                    <TextBox x:Name="LogTextBox"
                             Height="120"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </GroupBox>
            </TabItem>

        </TabControl>
    </Grid>
</Page>