<Page x:Class="VisionAICam.Pages.DiagnosticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="DiagnosticsPage">

    <Page.Resources>
        <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#263238" Offset="0"/>
            <GradientStop Color="#37474F" Offset="0.5"/>
            <GradientStop Color="#263238" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="PanelBackground" Color="#37474F"/>
        <SolidColorBrush x:Key="CardBackground" Color="#263238"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#1976D2"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFD700"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryForeBrush" Color="#B0BEC5"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,6"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource CardBackground}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2196F3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        </Style>
    </Page.Resources>

    <Page.Background>
        <StaticResource ResourceKey="PageBackgroundBrush"/>
    </Page.Background>

    <Grid Margin="20">
        <TabControl>

            <!-- System Info -->
            <TabItem Header="System Info">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <GroupBox Header="System Information" Margin="16">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="OS:" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="OsVersionText"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text=".NET:" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DotNetVersionText"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Memory:" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MemoryText"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="CPU:" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CpuText"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Cameras:" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="CameraListText"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Camera Status:" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="CameraStatusText"/>
                        </Grid>
                    </GroupBox>
                </ScrollViewer>
            </TabItem>

            <!-- Model Tab -->
            <TabItem Header="Model">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <GroupBox Header="Model" Margin="16">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
                                <TextBlock Text="Selected model:" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock x:Name="ModelPathText" Text="(none)" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DockPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button x:Name="SelectModelButton" Style="{StaticResource ActionButton}" Content="📂 Select Model..." Click="SelectModelButton_Click"/>
                                    <Button x:Name="SaveModelButton" Style="{StaticResource ActionButton}" Content="💾 Save Model" Click="SaveModelButton_Click"/>
                                    <Button x:Name="ToggleModelDetailsButton" Style="{StaticResource ActionButton}" Content="📋 Show Details" Click="ToggleModelDetailsButton_Click"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="LoadImageButton" Style="{StaticResource ActionButton}" Content="🖼️ Load Image..." Click="LoadImageButton_Click"/>
                                    <Button x:Name="RunInferenceButton" Style="{StaticResource ActionButton}" Content="🚀 Run Inference" Background="#4CAF50" Click="RunInferenceButton_Click"/>
                                </StackPanel>
                            </Grid>

                            <TextBox Grid.Row="2" x:Name="ModelDetailsTextBox" Visibility="Collapsed" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="200" IsReadOnly="True" FontFamily="Consolas" Margin="0,0,0,12"/>

                            <Border Grid.Row="3" BorderThickness="2" Padding="8" MinHeight="400">
                                <Grid>
                                    <Viewbox Stretch="Uniform">
                                        <Grid Width="640" Height="480">
                                            <Image x:Name="ModelTestImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Canvas x:Name="ModelBoundingCanvas" Background="Transparent" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                        </Grid>
                                    </Viewbox>
                                </Grid>
                            </Border>
                        </Grid>
                    </GroupBox>
                </ScrollViewer>
            </TabItem>

            <!-- Performance Tab -->
            <TabItem Header="Performance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <GroupBox Header="Performance Metrics" Margin="16">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="FPS:" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="FpsText"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Inference Time:" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InferenceTimeText"/>
                        </Grid>
                    </GroupBox>
                </ScrollViewer>
            </TabItem>

            <!-- Modbus Tab -->
            <TabItem Header="Modbus">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <GroupBox Header="Modbus" Margin="16">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Server (embedded) -->
                            <GroupBox Header="Server (embedded)" Grid.Column="0" Margin="6">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Listener Port:" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Width="110"/>
                                        <TextBlock x:Name="ModbusPortText" Text="(not configured)" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="Status:" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Width="110"/>
                                        <TextBlock x:Name="ModbusStatusText" Text="Stopped" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="Register snapshot (server):" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0"/>
                                    <TextBox x:Name="ModbusSnapshotTextBox" MinHeight="140" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Left">
                                        <TextBlock Text="Addr:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="ModbusAddrText" Width="80" Text="1000"/>
                                        <TextBlock Text="Value:" VerticalAlignment="Center" Margin="12,0,6,0"/>
                                        <TextBox x:Name="ModbusValueText" Width="120" Text="0"/>
                                        <Button x:Name="WriteRegisterButton" Content="Write (Server)" Margin="12,0,0,0" Click="WriteRegisterButton_Click"/>
                                        <Button x:Name="WriteTestPatternButton" Content="Test Pattern (Server)" Margin="6,0,0,0" Click="WriteTestPatternButton_Click"/>
                                        <Button x:Name="RefreshModbusSnapshotButton" Content="Refresh" Margin="6,0,0,0" Click="RefreshModbusSnapshotButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <!-- Client (remote) -->
                            <GroupBox Header="Client (remote)" Grid.Column="1" Margin="6">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Host:" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Width="50"/>
                                        <TextBox x:Name="ModbusClientHostText" Width="140" Text="127.0.0.1"/>
                                        <TextBlock Text="Port:" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="12,0,6,0"/>
                                        <TextBox x:Name="ModbusClientPortText" Width="80" Text="502"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="Slave ID:" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Width="70"/>
                                        <TextBox x:Name="ModbusClientSlaveText" Width="60" Text="1"/>
                                        <CheckBox x:Name="ModbusOneBasedCheck" Content="Use 1-based addressing" Margin="12,0,0,0" IsChecked="True" VerticalAlignment="Center"/>
                                        <Button x:Name="ModbusClientConnectButton" Content="Connect" Margin="12,0,0,0" Click="ModbusClientConnectButton_Click"/>
                                        <Button x:Name="ModbusClientDisconnectButton" Content="Disconnect" Margin="6,0,0,0" Click="ModbusClientDisconnectButton_Click"/>
                                        <TextBlock x:Name="ModbusClientStatusText" Text="Disconnected" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="Client Read Results:" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0"/>
                                    <TextBox x:Name="ModbusClientResultTextBox" MinHeight="80" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Left">
                                        <TextBlock Text="Addr:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="ModbusClientAddrText" Width="80" Text="1000"/>
                                        <TextBlock Text="Count:" VerticalAlignment="Center" Margin="12,0,0,6"/>
                                        <TextBox x:Name="ModbusCountText" Width="80" Text="1"/>
                                        <Button x:Name="ReadRegistersButton" Content="Read" Margin="12,0,0,0" Click="ReadRegistersButton_Click"/>
                                        <Button x:Name="WriteRegisterClientButton" Content="Write (Client)" Margin="6,0,0,0" Click="WriteRegisterClientButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                        </Grid>
                    </GroupBox>
                </ScrollViewer>
            </TabItem>

            <!-- Logs Tab -->
            <TabItem Header="Logs">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <GroupBox Header="System Logs" Margin="16">
                        <TextBox x:Name="LogTextBox" MinHeight="400" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
                    </GroupBox>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Page>