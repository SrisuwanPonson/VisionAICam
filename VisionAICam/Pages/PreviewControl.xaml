<UserControl x:Class="VisionAICam.Pages.PreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">
    <Border BorderBrush="#90CAF9" BorderThickness="1" CornerRadius="8" Background="White">
        <Grid>
            <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" Background="Transparent"/>
        </Grid>
    </Border>
</UserControl>