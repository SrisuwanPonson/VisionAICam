<UserControl x:Class="VisionAICam.Pages.PreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto"
             Foreground="{StaticResource TextPrimaryBrush}">
    <!-- Reuse shared theme: border uses AccentBrush and SurfaceBrush so preview matches calibration dialogs -->
    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" Background="{StaticResource SurfaceBrush}">
        <Grid>
            <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" Background="Transparent"/>
        </Grid>
    </Border>
</UserControl>