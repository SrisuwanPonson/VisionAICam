<Page x:Class="VisionAICam.Pages.SettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SettingPage"
      Width="960"
      Height="630"
      HorizontalAlignment="Left"
      VerticalAlignment="Top">

    <Page.Resources>
        <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#263238" Offset="0"/>
            <GradientStop Color="#37474F" Offset="0.5"/>
            <GradientStop Color="#263238" Offset="1"/>
        </LinearGradientBrush>
    </Page.Resources>

    <Page.Background>
        <StaticResource ResourceKey="PageBackgroundBrush"/>
    </Page.Background>

    <Grid Margin="20"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Title -->
        <TextBlock Text="Settings"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,20"
                   Grid.Row="0"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Grid.ColumnSpan="2"/>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical">
                <!-- Camera Settings -->
                <GroupBox Header="Camera" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Default Camera:"/>
                        <ComboBox x:Name="DefaultCameraComboBox" Width="200" Margin="0,0,0,8"/>
                        <TextBlock Text="Brightness:"/>
                        <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="255" Width="200" Margin="0,0,0,8"/>
                        <TextBlock Text="Contrast:"/>
                        <Slider x:Name="ContrastSlider" Minimum="0" Maximum="255" Width="200" Margin="0,0,0,8"/>
                        <TextBlock Text="Exposure:"/>
                        <Slider x:Name="ExposureSlider" Minimum="-10" Maximum="-1" Width="200" Margin="0,0,0,8"/>
                    </StackPanel>
                </GroupBox>

                <!-- Model Settings -->
                <GroupBox Header="Model" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Default Model for Running:" VerticalAlignment="Center"/>
                        <TextBox x:Name="DefaultModelPathText"
                                 Text="(none selected)"
                                 Margin="10,0"
                                 MinWidth="320"
                                 IsReadOnly="True"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 HorizontalScrollBarVisibility="Auto"/>
                        <Button Content="Browse..." Margin="10,0,0,0" Click="BrowseModelButton_Click"/>
                        <Button Content="Select from Model Management..." Margin="10,0,0,0" Click="SelectFromModelManagementButton_Click"/>
                    </StackPanel>
                </GroupBox>

                <!-- General Settings -->
                <GroupBox Header="General" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Theme:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ThemeComboBox" Width="120" Margin="10,0">
                            <ComboBoxItem Content="Light"/>
                            <ComboBoxItem Content="Dark"/>
                        </ComboBox>
                    </StackPanel>
                </GroupBox>

                <!-- About -->
                <GroupBox Header="About" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="VisionAICam v1.0"/>
                        <TextBlock Text="© 2024 Your Company"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Save Button at bottom right -->
        <Button Content="Save"
                Width="120"
                Height="36"
                Margin="0,20,0,0"
                Grid.Row="2"
                Grid.Column="1"
                HorizontalAlignment="Right"
                Click="SaveButton_Click"/>
    </Grid>
</Page>
