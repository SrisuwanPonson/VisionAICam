<Page x:Class="VisionAICam.Pages.SettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SettingPage"
      Width="800"
      Height="450">

    <Grid Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>
        <StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Top">

            <!-- Camera Settings -->
            <GroupBox Header="Camera" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Default Camera:"/>
                    <ComboBox x:Name="DefaultCameraComboBox" Width="200"/>
                </StackPanel>
            </GroupBox>

            <!-- Model Settings -->
            <GroupBox Header="Model" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Default Model:" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DefaultModelPathText" Text="(none)" Margin="10,0"/>
                    <Button Content="Browse..." Margin="10,0" Click="BrowseModelButton_Click"/>
                </StackPanel>
            </GroupBox>

            <!-- General Settings -->
            <GroupBox Header="General" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Theme:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ThemeComboBox" Width="120" Margin="10,0">
                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="Dark"/>
                    </ComboBox>
                </StackPanel>
            </GroupBox>

            <!-- About -->
            <GroupBox Header="About">
                <StackPanel>
                    <TextBlock Text="VisionAICam v1.0"/>
                    <TextBlock Text="© 2024 Your Company"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </Grid>
</Page>
