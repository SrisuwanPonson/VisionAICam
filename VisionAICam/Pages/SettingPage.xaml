<Page x:Class="VisionAICam.Pages.SettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Settings"
      Background="Transparent">

    <Page.Resources>
        <!-- ✅ Dark theme palette matching DataSetPage -->
        <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#263238" Offset="0"/>
            <GradientStop Color="#37474F" Offset="0.5"/>
            <GradientStop Color="#263238" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="PanelBackground" Color="#37474F"/>
        <SolidColorBrush x:Key="CardBackground" Color="#263238"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#1976D2"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFD700"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryForeBrush" Color="#B0BEC5"/>

        <!-- ✅ TextBlock style for dark theme -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
        </Style>

        <!-- ✅ GroupBox style for dark theme -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- ✅ TabControl style for dark theme -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- ✅ TabItem style for dark theme -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,6"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource CardBackground}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ✅ TextBox style for dark theme -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- ✅ ComboBox style for dark theme -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- ✅ Button style for dark theme -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2196F3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ✅ Slider style for dark theme -->
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
    </Page.Resources>

    <Grid Margin="30" Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ✅ Title with dark theme -->
        <TextBlock Text="⚙️ Settings"
                   FontSize="32"
                   FontWeight="Bold"
                   Foreground="{StaticResource AccentBrush}"
                   Margin="0,0,0,20"
                   Grid.Row="0"/>

        <!-- ⭐ TAB CONTROL (ทุก tabs ใช้ dark theme อัตโนมัติจาก styles ข้างบน) -->
        <TabControl Grid.Row="1">

            <!-- ⭐ TAB 1: CAMERA BACKEND -->
            <TabItem Header="📹 Camera Backend">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" Background="{StaticResource CardBackground}">
                        <TextBlock Text="Select Camera Backend:" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ComboBox x:Name="CameraBackendComboBox" Width="300" HorizontalAlignment="Left">
                            <ComboBoxItem Content="OpenCv"/>
                            <ComboBoxItem Content="Hikvision"/>
                        </ComboBox>

                        <TextBlock Text="This setting determines which camera system Production will use."
                                   Margin="0,16,0,0"
                                   Foreground="{StaticResource SecondaryForeBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ⭐ TAB 2: CAMERA (OPENCV) -->
            <TabItem Header="📷 Camera (OpenCV)">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" Background="{StaticResource CardBackground}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Camera:"/>
                            <ComboBox x:Name="DefaultCameraComboBox"
                                      Grid.Row="0" Grid.Column="1"
                                      Width="300" HorizontalAlignment="Left"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Brightness (0–255):"/>
                            <Slider x:Name="BrightnessSlider"
                                    Grid.Row="1" Grid.Column="1"
                                    Minimum="0" Maximum="255"
                                    Width="300" HorizontalAlignment="Left"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Contrast (0–255):"/>
                            <Slider x:Name="ContrastSlider"
                                    Grid.Row="2" Grid.Column="1"
                                    Minimum="0" Maximum="255"
                                    Width="300" HorizontalAlignment="Left"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Exposure (-10 to 10):"/>
                            <Slider x:Name="ExposureSlider"
                                    Grid.Row="3" Grid.Column="1"
                                    Minimum="-10" Maximum="10"
                                    Width="300" HorizontalAlignment="Left"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Capture Folder:" VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="CaptureFolderPathText"
                                         MinWidth="300"
                                         IsReadOnly="True"
                                         VerticalAlignment="Center"/>
                                <Button Content="Browse..." Margin="10,0,0,0"
                                        x:Name="BrowseCaptureFolderButton"
                                        Click="BrowseCaptureFolderButton_Click"/>
                            </StackPanel>

                            <GroupBox Grid.Row="5" Grid.ColumnSpan="2"
                                      Header="📊 Tolerances (%) for Camera Calibration"
                                      Margin="0,20,0,0">
                                <Grid Margin="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Tolerance R (%)"/>
                                    <TextBox x:Name="TxtToleranceR" Grid.Row="0" Grid.Column="1" Width="100" HorizontalAlignment="Left"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Tolerance G (%)"/>
                                    <TextBox x:Name="TxtToleranceG" Grid.Row="1" Grid.Column="1" Width="100" HorizontalAlignment="Left"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Tolerance B (%)"/>
                                    <TextBox x:Name="TxtToleranceB" Grid.Row="2" Grid.Column="1" Width="100" HorizontalAlignment="Left"/>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ⭐ TAB 3: CAMERA (HIKVISION) -->
            <TabItem Header="📹 Camera (Hikvision)">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" Background="{StaticResource CardBackground}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Camera Index:"/>
                            <TextBox x:Name="HikCameraIndexTextBox"
                                     Grid.Row="0" Grid.Column="1"
                                     Width="150" HorizontalAlignment="Left"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Exposure Time (µs):"/>
                            <TextBox x:Name="HikExposureTextBox"
                                     Grid.Row="1" Grid.Column="1"
                                     Width="150" HorizontalAlignment="Left"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Gain (dB):"/>
                            <TextBox x:Name="HikGainTextBox"
                                     Grid.Row="2" Grid.Column="1"
                                     Width="150" HorizontalAlignment="Left"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Gamma:"/>
                            <TextBox x:Name="HikGammaTextBox"
                                     Grid.Row="3" Grid.Column="1"
                                     Width="150" HorizontalAlignment="Left"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Black Level:"/>
                            <TextBox x:Name="HikBlackLevelTextBox"
                                     Grid.Row="4" Grid.Column="1"
                                     Width="150" HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ⭐ TAB 4: MODEL -->
            <TabItem Header="🤖 Model">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" Background="{StaticResource CardBackground}">
                        <TextBlock Text="Default Model Path:" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox x:Name="DefaultModelPathText"
                                     MinWidth="400"
                                     IsReadOnly="True"
                                     VerticalAlignment="Center"/>
                            <Button x:Name="BrowseModelButton"
                                    Content="Browse..."
                                    Click="BrowseModelButton_Click"
                                    Margin="10,0,0,0"/>
                        </StackPanel>
                        <Button Content="📂 Select from Model Management..."
                                HorizontalAlignment="Left"
                                x:Name="SelectFromModelManagementButton"
                                Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ⭐ Keep existing tabs: Inference, Preferences, About, Robot -->
            <!-- They will automatically use dark theme from styles above -->
            <!-- Just add ScrollViewer wrapper and Background to each if needed -->

        </TabControl>

        <!-- ✅ Save button with dark theme -->
        <Button Content="💾 Save Settings"
                x:Name="SaveButton"
                Width="180"
                Height="40"
                Margin="0,20,0,0"
                Grid.Row="2"
                HorizontalAlignment="Right"
                Click="SaveButton_Click"
                Background="#4CAF50"
                BorderBrush="{StaticResource AccentBrush}"/>
    </Grid>
</Page>