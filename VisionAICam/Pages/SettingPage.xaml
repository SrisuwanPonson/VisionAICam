<Page x:Class="VisionAICam.Pages.SettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Settings">

    <Page.Resources>
        <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5F5F5" Offset="0"/>
            <GradientStop Color="#E0E0E0" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Page.Resources>

    <Page.Background>
        <StaticResource ResourceKey="PageBackgroundBrush"/>
    </Page.Background>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Settings"
                   FontSize="30"
                   FontWeight="Bold"
                   Margin="0,0,0,20"
                   Grid.Row="0"/>

        <!-- ⭐ TAB CONTROL -->
        <TabControl Grid.Row="1">

            <!-- ⭐ TAB 1: CAMERA BACKEND -->
            <TabItem Header="Camera Backend">
                <StackPanel Margin="12">
                    <TextBlock Text="Select Camera Backend:"/>
                    <ComboBox x:Name="CameraBackendComboBox" Width="260">
                        <ComboBoxItem Content="OpenCv"/>
                        <ComboBoxItem Content="Hikvision"/>
                    </ComboBox>

                    <TextBlock Text="This setting determines which camera system Production will use."
                               Margin="0,12,0,0"
                               Foreground="Gray"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>

            <!-- ⭐ TAB 2: CAMERA (OPENCV) — ของเดิม -->
            <TabItem Header="Camera (OpenCV)">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Camera:"/>
                    <ComboBox x:Name="DefaultCameraComboBox"
                              Grid.Row="0" Grid.Column="1"
                              Width="260"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Brightness (0–255):"/>
                    <Slider x:Name="BrightnessSlider"
                            Grid.Row="1" Grid.Column="1"
                            Minimum="0" Maximum="255"
                            Width="260"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Contrast (0–255):"/>
                    <Slider x:Name="ContrastSlider"
                            Grid.Row="2" Grid.Column="1"
                            Minimum="0" Maximum="255"
                            Width="260"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Exposure (-10 to 10):"/>
                    <Slider x:Name="ExposureSlider"
                            Grid.Row="3" Grid.Column="1"
                            Minimum="-10" Maximum="10"
                            Width="260"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Capture Folder:"/>
                    <WrapPanel Grid.Row="4" Grid.Column="1">
                        <TextBox x:Name="CaptureFolderPathText"
                                 MinWidth="260"
                                 IsReadOnly="True"/>
                        <Button Content="Browse..." Margin="10,0"
                                x:Name="BrowseCaptureFolderButton"
                                Click="BrowseCaptureFolderButton_Click"/>
                    </WrapPanel>

                    <GroupBox Grid.Row="5" Grid.ColumnSpan="2"
                              Header="Tolerances (percent) for camera calibration"
                              Margin="6" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tolerance R (%)"/>
                            <TextBox x:Name="TxtToleranceR" Grid.Row="0" Grid.Column="1" Width="80"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Tolerance G (%)"/>
                            <TextBox x:Name="TxtToleranceG" Grid.Row="1" Grid.Column="1" Width="80"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Tolerance B (%)"/>
                            <TextBox x:Name="TxtToleranceB" Grid.Row="2" Grid.Column="1" Width="80"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ⭐ TAB 3: CAMERA (HIKVISION) -->
            <TabItem Header="Camera (Hikvision)">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Camera Index:"/>
                    <TextBox x:Name="HikCameraIndexTextBox"
                             Grid.Row="0" Grid.Column="1"
                             Width="120"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Exposure Time (µs):"/>
                    <TextBox x:Name="HikExposureTextBox"
                             Grid.Row="1" Grid.Column="1"
                             Width="120"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Gain (dB):"/>
                    <TextBox x:Name="HikGainTextBox"
                             Grid.Row="2" Grid.Column="1"
                             Width="120"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Gamma:"/>
                    <TextBox x:Name="HikGammaTextBox"
                             Grid.Row="3" Grid.Column="1"
                             Width="120"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Black Level:"/>
                    <TextBox x:Name="HikBlackLevelTextBox"
                             Grid.Row="4" Grid.Column="1"
                             Width="120"/>
                </Grid>
            </TabItem>

            <!-- ⭐ TAB 4: MODEL (ของเดิม) -->
            <TabItem Header="Model">
                <StackPanel Margin="12">
                    <WrapPanel>
                        <TextBlock Text="Default Model:" VerticalAlignment="Center"/>
                        <TextBox x:Name="DefaultModelPathText"
                                 MinWidth="320"
                                 IsReadOnly="True"
                                 Margin="10,0"/>
                        <Button x:Name="BrowseModelButton"
                                Content="Browse..."
                                Click="BrowseModelButton_Click"
                                Margin="4,0,0,0" />
                    </WrapPanel>
                    <Button Content="Select from Model Management..."
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            x:Name="SelectFromModelManagementButton"/>
                </StackPanel>
            </TabItem>

            <!-- ⭐ TAB 5: INFERENCE (ของเดิม) -->
            <TabItem Header="Inference">
                <!-- ทั้งหมดของเดิม -->
                <!-- ไม่ลบ ไม่แตะ -->
                <!-- ... -->
            </TabItem>

            <!-- ⭐ TAB 6: PREFERENCES (ของเดิม) -->
            <TabItem Header="Preferences">
                <!-- ทั้งหมดของเดิม -->
                <!-- ... -->
            </TabItem>

            <!-- ⭐ TAB 7: ABOUT (ของเดิม) -->
            <TabItem Header="About">
                <!-- ทั้งหมดของเดิม -->
                <!-- ... -->
            </TabItem>

            <!-- ⭐ TAB 8: ROBOT (ของเดิม) -->
            <TabItem Header="Robot">
                <!-- ทั้งหมดของเดิม -->
                <!-- ... -->
            </TabItem>

        </TabControl>

        <Button Content="Save"
                x:Name="SaveButton"
                Width="120"
                Height="36"
                Margin="0,0,0,10"
                Grid.Row="2"
                HorizontalAlignment="Right"
                Click="SaveButton_Click"/>
    </Grid>
</Page>
