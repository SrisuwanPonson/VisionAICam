<Page x:Class="VisionAICam.Pages.SettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SettingPage">

    <Page.Resources>
        <!-- Light background gradient -->
        <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5F5F5" Offset="0"/>
            <GradientStop Color="#E0E0E0" Offset="1"/>
        </LinearGradientBrush>

        <!-- Text styling for light theme -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- GroupBox styling for clean borders -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Page.Resources>

    <Page.Background>
        <StaticResource ResourceKey="PageBackgroundBrush"/>
    </Page.Background>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="Settings"
                   FontSize="30"
                   FontWeight="Bold"
                   Margin="0,0,0,20"
                   Grid.Row="0"/>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical">

                <!-- Camera Settings -->
                <GroupBox Header="Camera Settings">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Default Camera:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="DefaultCameraComboBox"
                                  Grid.Row="0" Grid.Column="1"
                                  Width="250"
                                  ToolTip="Select the primary camera device"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Brightness (0–255):" VerticalAlignment="Center"/>
                        <Slider x:Name="BrightnessSlider"
                                Grid.Row="1" Grid.Column="1"
                                Minimum="0" Maximum="255"
                                Width="250"
                                ToolTip="Adjust image brightness"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Contrast (0–255):" VerticalAlignment="Center"/>
                        <Slider x:Name="ContrastSlider"
                                Grid.Row="2" Grid.Column="1"
                                Minimum="0" Maximum="255"
                                Width="250"
                                ToolTip="Adjust image contrast"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Exposure (-10 to -1):" VerticalAlignment="Center"/>
                        <Slider x:Name="ExposureSlider"
                                Grid.Row="3" Grid.Column="1"
                                Minimum="-10" Maximum="-1"
                                Width="250"
                                ToolTip="Adjust camera exposure level"/>
                    </Grid>
                </GroupBox>

                <!-- Model Settings -->
                <GroupBox Header="Model Configuration">
                    <WrapPanel Margin="10">
                        <TextBlock Text="Default Model:" VerticalAlignment="Center"/>
                        <TextBox x:Name="DefaultModelPathText"
                                 Text="(none selected)"
                                 MinWidth="320"
                                 IsReadOnly="True"
                                 Margin="10,0"
                                 HorizontalScrollBarVisibility="Auto"/>
                        <Button Content="Browse..." Margin="10,0" Click="BrowseModelButton_Click"/>
                        <Button Content="Select from Model Management..." Margin="10,0" Click="SelectFromModelManagementButton_Click"/>
                    </WrapPanel>
                </GroupBox>

                <!-- General Settings -->
                <GroupBox Header="General Preferences">
                    <WrapPanel Margin="10">
                        <TextBlock Text="Theme:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ThemeComboBox" Width="120" Margin="10,0">
                            <ComboBoxItem Content="Light" IsSelected="True"/>
                            <ComboBoxItem Content="Dark"/>
                        </ComboBox>
                    </WrapPanel>
                </GroupBox>

                <!-- About -->
                <GroupBox Header="About VisionAICam">
                    <StackPanel Margin="10">
                        <TextBlock Text="Version: 1.0"/>
                        <TextBlock Text="© 2024 Your Company"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Save Button -->
        <Button Content="Save"
                Width="120"
                Height="36"
                Margin="0,0,0,10"
                Grid.Row="2"
                HorizontalAlignment="Right"
                Click="SaveButton_Click"/>
    </Grid>
</Page>