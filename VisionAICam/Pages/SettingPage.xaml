
<Page x:Class="VisionAICam.Pages.SettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Settings">

    <Page.Resources>
        <!-- Background gradient -->
        <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5F5F5" Offset="0"/>
            <GradientStop Color="#E0E0E0" Offset="1"/>
        </LinearGradientBrush>

        <!-- Base text styling -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
        </Style>

        <!-- GroupBox styling -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Page.Resources>

    <Page.Background>
        <StaticResource ResourceKey="PageBackgroundBrush"/>
    </Page.Background>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="Settings"
                   FontSize="30"
                   FontWeight="Bold"
                   Margin="0,0,0,20"
                   Grid.Row="0"/>

        <!-- Tabbed Content -->
        <TabControl Grid.Row="1">
            <!-- 🎥 Camera Settings -->
            <TabItem Header="Camera">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Camera:"/>
                    <ComboBox x:Name="DefaultCameraComboBox"
                              Grid.Row="0" Grid.Column="1"
                              Width="260"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Brightness (0–255):"/>
                    <Slider x:Name="BrightnessSlider"
                            Grid.Row="1" Grid.Column="1"
                            Minimum="0" Maximum="255"
                            Width="260"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Contrast (0–255):"/>
                    <Slider x:Name="ContrastSlider"
                            Grid.Row="2" Grid.Column="1"
                            Minimum="0" Maximum="255"
                            Width="260"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Exposure (-10 to 10):"/>
                    <Slider x:Name="ExposureSlider"
                            Grid.Row="3" Grid.Column="1"
                            Minimum="-10" Maximum="10"
                            Width="260"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Capture Folder:"/>
                    <WrapPanel Grid.Row="4" Grid.Column="1">
                        <TextBox x:Name="CaptureFolderPathText"
                                 MinWidth="260"
                                 IsReadOnly="True"/>
                        <Button Content="Browse..." Margin="10,0" x:Name="BrowseCaptureFolderButton" Click="BrowseCaptureFolderButton_Click"/>
                    </WrapPanel>
                </Grid>
            </TabItem>

            <!-- 🧠 Model Configuration -->
            <TabItem Header="Model">
                <StackPanel Margin="12">
                    <WrapPanel>
                        <TextBlock Text="Default Model:" VerticalAlignment="Center"/>
                        <TextBox x:Name="DefaultModelPathText"
                                 MinWidth="320"
                                 IsReadOnly="True"
                                 Margin="10,0"/>
                        <Button x:Name="BrowseModelButton"
                                Content="Browse..."
                                Click="BrowseModelButton_Click"
                                Margin="4,0,0,0" />
                    </WrapPanel>
                    <Button Content="Select from Model Management..."
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            x:Name="SelectFromModelManagementButton"/>
                </StackPanel>
            </TabItem>

            <!-- Inference Settings -->
            <TabItem Header="Inference">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Python DLL -->
                        <RowDefinition Height="Auto"/> <!-- Runtime -->
                        <RowDefinition Height="Auto"/> <!-- Sampling Interval -->
                        <RowDefinition Height="Auto"/> <!-- Engine Options -->
                        <RowDefinition Height="*"/>    <!-- Status / Notes -->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Python DLL Path:" VerticalAlignment="Center"/>
                    <WrapPanel Grid.Row="0" Grid.Column="1">
                        <TextBox x:Name="PythonDllPathText" MinWidth="360" IsReadOnly="True"/>
                        <Button Content="Browse..." Margin="10,0" x:Name="BrowsePythonDllButton" ToolTip="Add Click handler BrowsePythonDllButton_Click in SettingPage.xaml.cs"/>
                    </WrapPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Runtime:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="InferenceRuntimeComboBox" Grid.Row="1" Grid.Column="1" Width="240" Margin="0,6,0,6">
                        <ComboBoxItem Content="pythonnet (default)"/>
                        <ComboBoxItem Content="ONNX Runtime"/>
                        <ComboBoxItem Content="Other"/>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Sampling Interval (ms):" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,4">
                        <Slider x:Name="SamplingIntervalSlider"
                                Width="220"
                                Minimum="1" Maximum="2000"
                                SmallChange="1" LargeChange="10"
                                TickFrequency="10" IsSnapToTickEnabled="False"
                                Value="{Binding SamplingInterval, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox x:Name="SamplingIntervalTextBox"
                                 Width="64"
                                 Margin="8,0,0,0"
                                 Text="{Binding SamplingInterval, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalContentAlignment="Center"/>
                        <TextBlock Text="ms" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Engine Options:" VerticalAlignment="Top"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Vertical" Margin="0,6,0,6">
                        <CheckBox x:Name="InferenceEnableCachingCheckBox" Content="Enable engine caching" IsChecked="True" Margin="0,4"/>
                        <CheckBox x:Name="InferencePrewarmCheckBox" Content="Pre-warm on startup" IsChecked="False" Margin="0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Test Inference" x:Name="TestInferenceButton" IsEnabled="False" ToolTip="Implement handler to run a quick test inference (disabled by default)"/>
                            <TextBlock Text=" " Width="8"/>
                            <Button Content="Reset to Defaults" x:Name="ResetInferenceDefaultsButton" ToolTip="Implement handler to restore inference defaults"/>
                        </StackPanel>
                    </StackPanel>

                    <GroupBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Header="Status / Notes" Margin="0,12,0,0">
                        <TextBox x:Name="InferenceStatusText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="120"/>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- 🎨 Preferences -->
            <TabItem Header="Preferences">
                <StackPanel Margin="12">
                    <WrapPanel>
                        <TextBlock Text="Theme:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ThemeComboBox" Width="120" Margin="10,0">
                            <ComboBoxItem Content="Light"/>
                            <ComboBoxItem Content="Dark"/>
                        </ComboBox>
                    </WrapPanel>

                    <StackPanel Orientation="Horizontal" Margin="12,8,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Polygon auto-close threshold (px):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider
                            x:Name="PolygonAutoCloseThresholdSlider"
                            Width="200"
                            Minimum="1"
                            Maximum="200"
                            TickFrequency="1"
                            SmallChange="1"
                            LargeChange="10"
                            Value="{Binding PolygonAutoCloseThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            x:Name="PolygonAutoCloseThresholdTextBox"
                            Width="60"
                            Margin="8,0,0,0"
                            VerticalContentAlignment="Center"
                            Text="{Binding PolygonAutoCloseThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.##}}" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- ℹ️ About -->
            <TabItem Header="About">
                <StackPanel Margin="12">
                    <TextBlock Text="Version: 1.0"/>
                    <TextBlock Text="© 2024 VisionAICam Team"/>
                </StackPanel>
            </TabItem>

            <!-- 🤖 Robot Settings -->
            <TabItem Header="Robot">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Master Controller IP:" VerticalAlignment="Center"/>
                    <TextBox x:Name="RobotIpTextBox" Grid.Row="0" Grid.Column="1" MinWidth="240"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Port:" VerticalAlignment="Center"/>
                    <TextBox x:Name="RobotPortTextBox" Grid.Row="1" Grid.Column="1" MinWidth="120"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Swap float words:" VerticalAlignment="Center"/>
                    <CheckBox x:Name="RobotSwapWordsCheckBox" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"/>

                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <Button x:Name="RobotConnectButton" Content="Connect" Width="100" Click="RobotConnectButton_Click"/>
                        <TextBlock x:Name="RobotStatusTextBlock" Margin="12,6,0,0" Foreground="Gray" Text="Not connected"/>
                    </StackPanel>

                    <Separator Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8"/>

                    <!-- Modbus mapping UI -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Register address:" VerticalAlignment="Top"/>
                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="RobotRegisterAddressTextBox" Width="120" VerticalAlignment="Center"/>
                            <Button x:Name="SaveRobotSettingsButton" Content="Save Map" Width="80" Margin="12,0,0,0"/>
                            <Button x:Name="ReloadRobotSettingsButton" Content="Reload" Width="60" Margin="6,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="Class → ID mapping (comma list maps to 1,2,.. or use lines 'name=number')"
                                   FontSize="11" Foreground="Gray" Margin="0,8,0,6"/>

                        <TextBox x:Name="ClassIdMapTextBox"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Height="140"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Save Button -->
        <Button Content="Save"
                x:Name="SaveButton"
                Width="120"
                Height="36"
                Margin="0,0,0,10"
                Grid.Row="2"
                HorizontalAlignment="Right"
                Click="SaveButton_Click"/>
    </Grid>
</Page>