<Window x:Class="VisionAICam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VisionAICam"
        Height="768" Width="1024"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Background="#1E1E1E">

    <Window.Resources>
        <!-- Modern Dark Circle Button Style -->
        <Style x:Key="CircleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#007ACC"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="ButtonEllipse" 
                                   Fill="{TemplateBinding Background}"
                                   Stroke="{TemplateBinding BorderBrush}"
                                   StrokeThickness="{TemplateBinding BorderThickness}"/>
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonEllipse" Property="Fill" Value="#3E3E42"/>
                                <Setter TargetName="ButtonEllipse" Property="Stroke" Value="#1E90FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonEllipse" Property="Fill" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark Rounded Navigation Button Style -->
        <Style x:Key="RoundedNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="8"
                              Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="IconText" 
                                         FontFamily="Segoe MDL2 Assets" 
                                         FontSize="18" 
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3E3E42"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigation Button with Icon Style -->
        <Style x:Key="NavButtonWithIcon" TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="10"
                              Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="IconBlock"
                                         Text="{TemplateBinding Tag}"
                                         FontFamily="Segoe MDL2 Assets" 
                                         FontSize="20" 
                                         VerticalAlignment="Center"
                                         Margin="0,0,10,0"
                                         Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3E3E42"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#1E90FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#007ACC"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Bottom Navigation Bar -->
        <DockPanel x:Name="BottomNavGrid" DockPanel.Dock="Bottom" Height="80" FlowDirection="RightToLeft">
            <DockPanel.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1E1E1E" Offset="0"/>
                    <GradientStop Color="#252526" Offset="0.5"/>
                    <GradientStop Color="#1E1E1E" Offset="1"/>
                </LinearGradientBrush>
            </DockPanel.Background>

            <UniformGrid Rows="1" FlowDirection="LeftToRight">
                <Button Tag="&#xE768;" Content="Run" Background="#3F51B5" BorderBrush="#303F9F" BorderThickness="2"
                        Foreground="White" Style="{StaticResource NavButtonWithIcon}" 
                        Click="ProductionButton_Click"/>
                <Button Tag="&#xE722;" Content="Cam" Background="#9C27B0" BorderBrush="#7B1FA2" BorderThickness="2"
                        Foreground="White" Style="{StaticResource NavButtonWithIcon}" 
                        Click="CameraButton_Click"/>
                <Button Tag="&#xE8F4;" Content="Images" Background="#009688" BorderBrush="#00796B" BorderThickness="2"
                        Foreground="White" Style="{StaticResource NavButtonWithIcon}" 
                        Click="DataSetButton_Click"/>
                <Button Tag="&#xE8B7;" Content="Robot" Background="#FF6F00" BorderBrush="#E65100" BorderThickness="2"
                        Foreground="White" Style="{StaticResource NavButtonWithIcon}"
                        Click="NavigatorRobotButton_Click"/>
                <Button Tag="&#xE950;" Content="Model" 
                        Style="{StaticResource NavButtonWithIcon}"
                        Click="ModelButton_Click"/>
                <Button Tag="&#xE713;" Content="Settings" 
                        Style="{StaticResource NavButtonWithIcon}"
                        Click="SettingsButton_Click"/>
                <Button Tag="&#xEBE8;" Content="Diag" 
                        Style="{StaticResource NavButtonWithIcon}"
                        Click="DiagnosticButton_Click"/>
                <Button Tag="&#xE81C;" Content="Data" 
                        Style="{StaticResource NavButtonWithIcon}"
                        Click="DataButton_Click"/>
                <Button Tag="&#xE77B;" Content="User" 
                        Style="{StaticResource NavButtonWithIcon}"
                        Click="UserButton_Click"/>
            </UniformGrid>
        </DockPanel>

        <!-- Left statistics panel -->
        <Grid x:Name="LeftPanel" DockPanel.Dock="Left" Width="180" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#252526" Offset="0"/>
                    <GradientStop Color="#2D2D30" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,50,0,0">
                <StackPanel Margin="8">
                    <!-- Statistics Section -->
                    <TextBlock Text="📈 Statistics" 
                               FontSize="11" 
                               FontWeight="Bold"
                               Foreground="#1E90FF"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    
                    <Border Background="#2D2D30" 
                            BorderBrush="#007ACC" 
                            BorderThickness="1" 
                            CornerRadius="4" 
                            Padding="8,6"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Total:" FontSize="9" Foreground="#B0B0B0" Width="65"/>
                                <TextBlock x:Name="TotalCountTextBlock" Text="0" FontSize="9" FontWeight="Bold" Foreground="#FFD700"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Session:" FontSize="9" Foreground="#B0B0B0" Width="65"/>
                                <TextBlock x:Name="SessionCountTextBlock" Text="0" FontSize="9" FontWeight="Bold" Foreground="#00FF00"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Frames:" FontSize="9" Foreground="#B0B0B0" Width="65"/>
                                <TextBlock x:Name="FrameCountTextBlock" Text="0" FontSize="9" FontWeight="Bold" Foreground="#E0E0E0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button x:Name="ResetStatsButton"
                            Content="🔄 Reset"
                            FontSize="9"
                            Height="24"
                            Margin="0,0,0,12"
                            Background="#2D2D30"
                            Foreground="#E0E0E0"
                            BorderBrush="#007ACC"
                            BorderThickness="1"
                            Click="ResetStatsButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" 
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#3E3E42"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Current Frame Section -->
                    <TextBlock Text="📊 Current Frame" 
                               FontSize="11" 
                               FontWeight="Bold"
                               Foreground="#1E90FF"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <DataGrid x:Name="PerFrameSummaryGrid"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              Background="Transparent"
                              RowBackground="Transparent"
                              AlternatingRowBackground="Transparent"
                              GridLinesVisibility="None"
                              BorderThickness="0"
                              CanUserResizeColumns="False">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="Foreground" Value="#FFD700"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="9"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontSize" Value="9"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="Class" FontSize="9"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ClassName}"
                                                   Foreground="{Binding ColorBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="9"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding Count}" Width="35">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="#" FontSize="9"/>
                                </DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFD700"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="9"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- Collapse button inside left panel (top-right) -->
            <Button x:Name="LeftCollapseButton"
                    Click="LeftCollapseButton_Click"
                    Style="{StaticResource CircleButtonStyle}"
                    Width="36" Height="36"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="6">
                <TextBlock Text="&#xE76B;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </Button>
        </Grid>

        <!-- Right-side vertical navigator bar -->
        <StackPanel x:Name="RightPanel" DockPanel.Dock="Right"
                    Orientation="Vertical"
                    Width="100"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Margin="0">
            <StackPanel.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#252526" Offset="0"/>
                    <GradientStop Color="#007ACC" Offset="0.5"/>
                    <GradientStop Color="#2D2D30" Offset="1"/>
                </LinearGradientBrush>
            </StackPanel.Background>

            <!-- Collapse button inside right panel (top-left) -->
            <Button x:Name="RightCollapseButton"
                    Click="RightCollapseButton_Click"
                    Style="{StaticResource CircleButtonStyle}"
                    Width="36" Height="36"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="6">
                <TextBlock Text="&#xE76C;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="16"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </Button>

            <Button x:Name="StartStopButton"
                    Content="&#xE768;"
                    Margin="0,30,0,0"
                    Style="{StaticResource CircleButtonStyle}"
                    Click="StartStopButton_Click"
                    ToolTip="Start/Stop Production"/>
            <Button x:Name="PauseButton"
                    Content="&#xE769;"
                    Margin="10"
                    Style="{StaticResource CircleButtonStyle}"
                    Click="PauseButton_Click"
                    ToolTip="Pause/Resume Production"/>
            <Button x:Name="ExitButton"
                    Content="&#xE8BB;"
                    Margin="10"
                    Style="{StaticResource CircleButtonStyle}"
                    Click="ExitButton_Click"
                    ToolTip="Exit Application"/>
        </StackPanel>

        <!-- Main content area with watermark -->
        <Grid Background="#1E1E1E">
            <Frame x:Name="MainContent"
                   NavigationUIVisibility="Hidden"
                   Background="Transparent"/>

            <!-- Version Display - No Border, No Background -->
            <TextBlock x:Name="VersionTextBlock" 
                       Text="v1.0.0 | Rev: 2026-08-02"
                       Foreground="#707070" 
                       FontSize="10" 
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0,4,8,0"
                       Panel.ZIndex="999"
                       IsHitTestVisible="False"/>

            <!-- Expand buttons shown when panels are collapsed -->
            <Button x:Name="LeftExpandButton"
                    Click="LeftExpandButton_Click"
                    Style="{StaticResource CircleButtonStyle}"
                    Width="36" Height="36"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="6"
                    Visibility="Collapsed"
                    Panel.ZIndex="1000">
                <TextBlock Text="&#xE76C;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </Button>

            <Button x:Name="RightExpandButton"
                    Click="RightExpandButton_Click"
                    Style="{StaticResource CircleButtonStyle}"
                    Width="36" Height="36"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="6"
                    Visibility="Collapsed"
                    Panel.ZIndex="1000">
                <TextBlock Text="&#xE76B;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </Button>

            <!-- AI watermark overlay -->
            <TextBlock Text="Demo Version"
                       FontSize="60"
                       FontWeight="Bold"
                       Foreground="#33007ACC"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderTransformOrigin="0.5,0.5"
                       IsHitTestVisible="False"
                       Opacity="0.15">
                <TextBlock.RenderTransform>
                    <RotateTransform Angle="-30"/>
                </TextBlock.RenderTransform>
            </TextBlock>
        </Grid>

    </DockPanel>
</Window>