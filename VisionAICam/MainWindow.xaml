<Window x:Class="VisionAICam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VisionAICam"
        Height="768"
        Width="1024"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal">

    <Window.Resources>
        <!-- Circular Button Style -->
        <Style x:Key="CircleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Background" Value="#FFF"/>
            <Setter Property="BorderBrush" Value="#2196F3"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="#2196F3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="{TemplateBinding BorderThickness}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded Navigation Button Style -->
        <Style x:Key="RoundedNavButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="6,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20"
                                Padding="10,4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Bottom horizontal navigator bar -->
        <DockPanel DockPanel.Dock="Bottom" Height="70" LastChildFill="False" FlowDirection="RightToLeft">
            <DockPanel.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1C1C1C" Offset="0"/>
                    <GradientStop Color="#2E2E2E" Offset="0.5"/>
                    <GradientStop Color="#1C1C1C" Offset="1"/>
                </LinearGradientBrush>
            </DockPanel.Background>

            <UniformGrid x:Name="BottomNavGrid" Rows="1" Columns="9" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Button Content="Account" Background="#FF5722" BorderBrush="#E64A19" BorderThickness="2"
                        Foreground="White" Style="{StaticResource RoundedNavButtonStyle}" Click="UserButton_Click"/>
                <Button Content="Records" Background="#03A9F4" BorderBrush="#0288D1" BorderThickness="2"
                        Foreground="White" Style="{StaticResource RoundedNavButtonStyle}" Click="DataButton_Click"/>
                <Button Content="Debug" Background="#4CAF50" BorderBrush="#388E3C" BorderThickness="2"
                        Foreground="White" Style="{StaticResource RoundedNavButtonStyle}" Click="DiagnosticButton_Click"/>
                <Button Content="Config" Background="#FFC107" BorderBrush="#FFA000" BorderThickness="2"
                        Foreground="White" Style="{StaticResource RoundedNavButtonStyle}" Click="SettingsButton_Click"/>
                <Button Content="AI Core" Background="#00BCD4" BorderBrush="#0097A7" BorderThickness="2"
                        Foreground="White" Style="{StaticResource RoundedNavButtonStyle}" Click="ModelButton_Click"/>
                <Button x:Name="NavigatorRobotButton"
                        Content="Robot"
                        ToolTip="Open Navigator Robot"
                        Background="#00ACC1"
                        BorderBrush="#008B9A"
                        BorderThickness="2"
                        Foreground="White"
                        Style="{StaticResource RoundedNavButtonStyle}"
                        Click="NavigatorRobotButton_Click"/>
                <Button Content="Sample" Background="#009688" BorderBrush="#00796B" BorderThickness="2"
                        Foreground="White" Style="{StaticResource RoundedNavButtonStyle}" Click="DataSetButton_Click"/>
                <Button Content="Capture" Background="#9C27B0" BorderBrush="#7B1FA2" BorderThickness="2"
                        Foreground="White" Style="{StaticResource RoundedNavButtonStyle}" Click="CameraButton_Click"/>
                <Button Content="Run Task" Background="#3F51B5" BorderBrush="#303F9F" BorderThickness="2"
                        Foreground="White" Style="{StaticResource RoundedNavButtonStyle}" Click="ProductionButton_Click"/>
            </UniformGrid>
        </DockPanel>

        <!-- Left statistics panel -->
        <Grid x:Name="LeftPanel" DockPanel.Dock="Left" Width="140" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0">
            <Image Source="pack://application:,,,/Assets/vertical_panel.png"
                   Stretch="UniformToFill" Opacity="1"/>
            <StackPanel>
                <!-- Add your statistic controls here -->
            </StackPanel>

            <!-- Collapse button inside left panel (top-right) -->
            <Button x:Name="LeftCollapseButton"
        Click="LeftCollapseButton_Click"
        Style="{StaticResource CircleButtonStyle}"
        Width="36" Height="36"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Margin="6">
                <TextBlock Text="&#x25C0;"
               FontFamily="Segoe UI Symbol"
               FontSize="18"
               FontWeight="Bold"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"/>
            </Button>
        </Grid>

        <!-- Right-side vertical navigator bar -->
        <StackPanel x:Name="RightPanel" DockPanel.Dock="Right"
                    Orientation="Vertical"
                    Width="100"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Margin="0">
            <StackPanel.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#212121" Offset="0"/>
                    <GradientStop Color="#1976D2" Offset="0.5"/>
                    <GradientStop Color="#424242" Offset="1"/>
                </LinearGradientBrush>
            </StackPanel.Background>

            <!-- Collapse button inside right panel (top-left) -->
            <Button x:Name="RightCollapseButton"
        Click="RightCollapseButton_Click"
        Style="{StaticResource CircleButtonStyle}"
        Width="36" Height="36"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Margin="6">
                <TextBlock Text="▶"
               FontFamily="Segoe UI Symbol"
               FontSize="18"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"/>
            </Button>

            <Button x:Name="StartStopButton"
                    Content="&#xE768;"
                    Margin="0,30,0,0"
                    Style="{StaticResource CircleButtonStyle}"
                    Click="StartStopButton_Click"
                    ToolTip="Start/Stop Production"/>
            <Button x:Name="PauseButton"
                    Content="&#xE769;"
                    Margin="10"
                    Style="{StaticResource CircleButtonStyle}"
                    Click="PauseButton_Click"
                    ToolTip="Pause/Resume Production"/>
            <Button x:Name="ExitButton"
                    Content="&#xE8BB;"
                    Margin="10"
                    Style="{StaticResource CircleButtonStyle}"
                    Click="ExitButton_Click"
                    ToolTip="Exit Application"/>
        </StackPanel>

        <!-- Main content area with watermark -->
        <Grid>
            <Frame x:Name="MainContent"
           NavigationUIVisibility="Hidden"/>

            <!-- Expand buttons shown when panels are collapsed -->
            <Button x:Name="LeftExpandButton"
            Click="LeftExpandButton_Click"
            Style="{StaticResource CircleButtonStyle}"
            Width="36" Height="36"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Margin="6"
            Visibility="Collapsed"
            Panel.ZIndex="1000">
                <TextBlock Text="&#x25B6;"
                   FontFamily="Segoe UI Symbol"
                   FontSize="18"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
            </Button>

            <Button x:Name="RightExpandButton"
            Click="RightExpandButton_Click"
            Style="{StaticResource CircleButtonStyle}"
            Width="36" Height="36"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Margin="6"
            Visibility="Collapsed"
            Panel.ZIndex="1000">
                <TextBlock Text="&#x25C0;"
                   FontFamily="Segoe UI Symbol"
                   FontSize="18"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
            </Button>

            <!-- AI watermark overlay -->
            <TextBlock Text="Demo Version"
               FontSize="60"
               FontWeight="Bold"
               Foreground="#661976D2"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderTransformOrigin="0.5,0.5"
               IsHitTestVisible="False"
               Opacity="0.2">
                <TextBlock.RenderTransform>
                    <RotateTransform Angle="-30"/>
                </TextBlock.RenderTransform>
            </TextBlock>
        </Grid>

    </DockPanel>
</Window>